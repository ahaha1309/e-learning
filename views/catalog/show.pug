extends ../layouts/base

block content
  //- Cinematic Header
  .relative.w-full.border-b.border-border.bg-card.overflow-hidden
    //- Parallax Image Background (Simulated)
    //- §19 Performance: CSS gradient visual, no external images
    .absolute.inset-0.w-full(class='h-[120%]')
      .w-full.h-full.opacity-10(style='background:linear-gradient(135deg,hsl(var(--primary)/0.3) 0%,hsl(var(--info)/0.2) 50%,transparent 100%);')
      .absolute.inset-0.bg-gradient-to-b.from-transparent.to-card
      .absolute.inset-0.bg-gradient-to-r.from-card.via-card.to-transparent(class='via-card/90')
      
    .page-narrow.max-w-7xl.pt-20.pb-24.relative.z-10
      nav.breadcrumb.animate-in.fade-in.mb-8
        a(href='/catalog') Danh mục
        span.breadcrumb-sep /
        span.text-foreground.font-semibold= course.title
        
      .max-w-3xl.animate-in.slide-in-up
        .inline-flex.items-center.gap-2.rounded-full.text-primary.text-xs.font-bold.mb-6.tracking-widest.uppercase.border.px-4.py-2(class='border-primary/20 bg-primary/5')
          i.ph-fill.ph-bookmark-simple
          | #{course.category}
        h1.text-5xl.md_text-6xl.font-extrabold.tracking-tighter.leading-tight.mb-6.text-balance= course.title
        p.text-xl.md_text-2xl.text-muted-foreground.leading-relaxed.text-balance= course.summary
        
        .flex.flex-wrap.items-center.gap-8.mt-12
          .flex.items-center.gap-4
            .w-12.h-12.rounded-full.bg-muted.flex.items-center.justify-center.border.border-border
              i.ph-fill.ph-chalkboard-teacher.text-2xl.text-muted-foreground
            div
              p.text-sm.font-bold.text-foreground Có hướng dẫn
              p.text-xs.text-muted-foreground Được chuyên gia hướng dẫn

          .flex.items-center.gap-4
            .w-12.h-12.rounded-full.bg-muted.flex.items-center.justify-center.border.border-border
              i.ph-fill.ph-certificate.text-2xl.text-muted-foreground
            div
              p.text-sm.font-bold.text-foreground Chứng chỉ
              p.text-xs.text-muted-foreground Sau khi hoàn thành

  .page-narrow.max-w-7xl.py-16
    .grid.grid-cols-1.lg_grid-cols-12.gap-16.items-start
      //- Main Content (Left)
      .lg_col-span-8.space-y-16
        section.animate-in.slide-in-up(style='animation-delay: 100ms;')
          .inline-flex.items-center.gap-2.rounded-full.text-muted-foreground.text-xs.font-bold.uppercase.tracking-widest.border.border-border.px-4.py-2.mb-6(class='bg-muted/50') Chương trình giảng dạy
          h2.text-3xl.font-extrabold.tracking-tight.mb-8 Bạn sẽ học được gì
          .grid.grid-cols-1.md_grid-cols-2.gap-4
            each item, idx in ['Điều hướng bài học có cấu trúc', 'Bài tập và phản hồi từ giáo viên', 'Bài kiểm tra và thi với tiến trình rõ ràng', 'Các điểm thảo luận và trò chuyện']
              div.flex.items-start.gap-4.p-5.rounded-2xl.border.transition-colors(class='border-border/60 bg-muted/30 hover_bg-muted/60')
                .w-8.h-8.rounded-full.flex.items-center.justify-center.flex-shrink-0(class='bg-success/20')
                  i.ph-bold.ph-check.text-success.text-lg
                p.text-sm.text-foreground.font-medium.leading-relaxed.pt-1= item

        section.animate-in.slide-in-up(style='animation-delay: 200ms;')
          .inline-flex.items-center.gap-2.rounded-full.text-muted-foreground.text-xs.font-bold.uppercase.tracking-widest.border.border-border.px-4.py-2.mb-6(class='bg-muted/50') Bắt đầu
          h2.text-3xl.font-extrabold.tracking-tight.mb-6 Quá trình Đăng ký
          .prose.prose-lg.text-muted-foreground
            p Học sinh tham gia lớp học bằng mã do giáo viên cung cấp. Sau khi đăng ký, tất cả các bài giảng, bài tập, điểm danh, bài kiểm tra và thông báo sẽ xuất hiện tự nhiên trong không gian làm việc trên bảng điều khiển của học sinh.
            p Bạn sẽ có quyền truy cập trọn đời vào các tài liệu và kênh cộng đồng.

      //- Sticky Enrollment Ticket (Right)
      aside.lg_col-span-4.animate-in.slide-in-up(style='animation-delay: 300ms;')
        .sticky.top-24.glass-panel.p-6.space-y-6(class='rounded-[2rem]')
          //- §19 Performance: CSS-drawn course preview — no placehold.co
          .aspect-video.rounded-2xl.overflow-hidden.relative.mb-2.border(class='border-border/50 bg-muted')
            .absolute.inset-0.flex.flex-col.items-center.justify-center.gap-3
              .w-14.h-14.rounded-2xl.flex.items-center.justify-center.text-primary(class='bg-primary/10')
                i.ph-fill.ph-play-circle.text-4xl
              p.text-xs.font-bold.text-muted-foreground.uppercase.tracking-widest= course.category || 'Xem trước khóa học'
            .absolute.inset-0(style='background:linear-gradient(135deg,hsl(var(--primary)/0.08) 0%,hsl(var(--info)/0.05) 100%);')
          
          .space-y-2
            .flex.items-center.justify-between.py-4.border-b(class='border-border/60')
              span.flex.items-center.gap-3.text-sm.font-semibold.text-muted-foreground
                i.ph-fill.ph-chart-bar.text-xl
                | Mức độ khó
              strong.text-sm.font-bold= course.level
            .flex.items-center.justify-between.py-4.border-b(class='border-border/60')
              span.flex.items-center.gap-3.text-sm.font-semibold.text-muted-foreground
                i.ph-fill.ph-clock.text-xl
                | Tổng thời lượng
              strong.text-sm.font-bold= course.duration
            .flex.items-center.justify-between.py-4
              span.flex.items-center.gap-3.text-sm.font-semibold.text-muted-foreground
                i.ph-fill.ph-desktop.text-xl
                | Định dạng phân phối
              strong.text-sm.font-bold Lớp học

          .pt-6.space-y-4
            if user
              a.btn-primary.w-full.h-14.text-base.rounded-xl.shadow-diffused.active_scale-95.transition-transform(href='/student/classrooms')
                | Vào Lớp học
                i.ph-bold.ph-arrow-right.text-lg
            else
              a.btn-primary.w-full.h-14.text-base.rounded-xl.shadow-diffused.active_scale-95.transition-transform(href='/auth/register')
                | Yêu cầu Truy cập
                i.ph-bold.ph-arrow-right.text-lg
            p.text-xs.text-center.text-muted-foreground Truy cập trọn đời sau khi đăng ký.
