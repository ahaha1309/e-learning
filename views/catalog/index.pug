extends ../layouts/base

block content
  .page-narrow.max-w-7xl.space-y-12.pt-12.pb-32
    header.flex.flex-col.md_flex-row.md_items-end.justify-between.gap-8.animate-in.slide-in-up(style='animation-duration: 800ms;')
      div
        div.inline-flex.items-center.gap-2.rounded-full.border.text-primary.text-xs.font-bold.uppercase.tracking-widest.px-4.mb-4(class='border-primary/20 bg-primary/5 py-1.5 shadow-sm') Khám phá Kiến thức
        h1.text-5xl.md_text-6xl.font-extrabold.tracking-tighter Danh mục Khóa học
        p.mt-4.max-w-2xl.text-xl.text-muted-foreground.leading-relaxed Khám phá các kỹ năng bạn cần để thăng tiến.
      
      form.relative.group.w-full.md_w-96(method='GET', action='/catalog')
        label.sr-only(for='q') Tìm kiếm khóa học
        .absolute.inset-y-0.left-4.flex.items-center.pointer-events-none
          i.ph-bold.ph-magnifying-glass.text-xl.text-muted-foreground.group-focus-within_text-primary.transition-colors
        input#q(type='search', name='q', value=query, placeholder='Tìm kiếm chủ đề...', class='w-full h-14 pl-12 pr-16 bg-background/50 border border-border rounded-2xl shadow-inner focus:border-primary focus:ring-1 focus:ring-primary transition-colors text-base font-medium')
        .absolute.inset-y-0.right-4.flex.items-center.pointer-events-none
          span.hidden.sm_inline-flex.items-center.justify-center.px-2.h-6.font-bold.text-muted-foreground.bg-background.rounded-md.border.border-border.shadow-sm(class='text-[10px] font-mono') ⌘K

    .grid.grid-cols-1.lg_grid-cols-12.gap-12
      //- Sticky Sidebar Filters (25%)
      aside.lg_col-span-3.space-y-8.animate-in.slide-in-up(style='animation-delay: 100ms;')
        .sticky.top-24.space-y-10
          .space-y-5
            h3.text-xs.font-bold.uppercase.tracking-widest.text-muted-foreground Danh mục
            .flex.flex-col.gap-1
              a.flex.items-center.justify-between.px-4.rounded-xl.transition-all(href='/catalog', class=!selectedCategory ? 'bg-primary/10 text-primary font-bold shadow-sm py-2.5' : 'text-muted-foreground hover_bg-muted hover_text-foreground font-medium py-2.5')
                span Tất cả Khóa học
              each cat in categories
                a.flex.items-center.justify-between.px-4.rounded-xl.transition-all(href='/catalog?category=' + encodeURIComponent(cat.slug), class=selectedCategory === cat.slug ? 'bg-primary/10 text-primary font-bold shadow-sm py-2.5' : 'text-muted-foreground hover_bg-muted hover_text-foreground font-medium py-2.5')
                  span= cat.name
                  
          .border-t.border-border.pt-8.space-y-5
            h3.text-xs.font-bold.uppercase.tracking-widest.text-muted-foreground Độ khó
            .flex.flex-col.gap-1
              - var levels = [['', 'Tất cả'], ['Beginner', 'Cơ bản'], ['Intermediate', 'Trung cấp'], ['Advanced', 'Nâng cao']]
              each lvl in levels
                - var isActive = (selectedLevel || '') === lvl[0]
                - var href = '/catalog?' + (query ? 'q=' + encodeURIComponent(query) + '&' : '') + (selectedCategory ? 'category=' + encodeURIComponent(selectedCategory) + '&' : '') + (lvl[0] ? 'level=' + encodeURIComponent(lvl[0]) : '')
                a.flex.items-center.gap-3.px-4.py-2.rounded-xl.transition-all(href=href, class=isActive ? 'bg-primary/10 text-primary font-bold shadow-sm' : 'text-muted-foreground hover_bg-muted hover_text-foreground font-medium')
                  .w-4.h-4.rounded.border.flex.items-center.justify-center.flex-shrink-0(class=isActive ? 'bg-primary border-primary' : 'border-border')
                    if isActive
                      i.ph-bold.ph-check.text-white(style='font-size:10px')
                  span.text-sm= lvl[1]

      //- Spotlight Grid Course Cards (75%)
      .lg_col-span-9
        if loading
          .grid.grid-cols-1.md_grid-cols-2.xl_grid-cols-3.gap-8(aria-busy='true', aria-label='Đang tải khóa học')
            - var skeletonCols = [1,2,3,4,5,6,7,8,9]
            each _ in skeletonCols
              article.flex.flex-col(aria-hidden='true')
                .skeleton.skeleton-thumbnail.mb-5
                .skeleton.skeleton-text(class='!h-5')
                .skeleton.skeleton-text.mt-3
                .skeleton.skeleton-text-short.mt-2
                .flex.items-center.justify-between.mt-6
                  .skeleton.rounded(class='!h-4 !w-20')
                  .skeleton.rounded-full(class='!h-8 !w-8')
        else if courses.length
          .grid.grid-cols-1.md_grid-cols-2.xl_grid-cols-3.gap-8
            each course, index in courses
              article.group.relative.flex.flex-col.animate-in.slide-in-up(style=`animation-delay: ${(index % 6 + 2) * 100}ms`)
                a.absolute.inset-0.z-10(href='/catalog/' + course.slug)
                  span.sr-only Xem #{course.title}
                div.relative.w-full.aspect-video.rounded-2xl.overflow-hidden.bg-muted.mb-5.border.group-hover_border-primary.border-border(class='group-hover_border-primary/40 transition-all duration-300')
                  - var seed = course.slug || course.title
                  .absolute.inset-0(style=`background:linear-gradient(135deg,hsl(var(--primary)/0.22),hsl(var(--info)/0.16),hsl(var(--warning)/0.14));`)
                  .absolute.inset-0.flex.items-center.justify-center
                    span.font-mono.font-black.tracking-tighter.text-foreground.opacity-25(style='font-size:clamp(2rem,6vw,3.5rem)')= (course.category || 'LMS').charAt(0).toUpperCase()
                  .absolute.bottom-3.left-3.right-3.flex.items-end.justify-between
                    span.inline-flex.items-center.rounded-lg.py-1.text-xs.font-bold.uppercase.tracking-widest.text-foreground.bg-card.backdrop-blur-md.shadow-sm(class='gap-1.5 px-2.5')
                      i.ph-fill(class=(course.category && course.category.match(/code|dev|tech|web|prog/i) ? 'ph-code' : 'ph-book-open'))
                      | #{course.category || 'Khóa học'}
                    .w-8.h-8.rounded-full.bg-card.backdrop-blur-md.flex.items-center.justify-center.text-muted-foreground.transition-all.duration-300.shadow-sm(class='group-hover_bg-primary group-hover_text-white')
                      i.ph-bold.ph-arrow-right
                div.flex-1.flex.flex-col
                  h2.text-xl.font-extrabold.tracking-tight.leading-tight.truncate-2.mb-2.group-hover_text-primary.transition-colors= course.title
                  p.text-sm.text-muted-foreground.truncate-2.mb-6.flex-1.leading-relaxed= course.summary
                  .flex.items-center.justify-between.mt-auto
                    .flex.items-center.gap-2.text-xs.font-bold.text-muted-foreground.tracking-widest.uppercase
                      i.ph-bold.ph-tag.text-base
                      | #{course.level || ''}
        else
          .glass-panel.h-96.flex.flex-col.items-center.justify-center.text-center.animate-in.fade-in(class='rounded-[2.5rem]', style='animation-delay: 200ms;')
            div.w-24.h-24.rounded-3xl.flex.items-center.justify-center.mb-8(class='bg-muted/50')
              i.ph-fill.ph-magnifying-glass.text-5xl(class='text-muted-foreground/30')
            h2.text-3xl.font-extrabold.text-foreground.tracking-tighter Không tìm thấy khóa học nào
            p.text-lg.text-muted-foreground.mt-3.max-w-md Hãy thử điều chỉnh từ khóa tìm kiếm hoặc xóa bộ lọc danh mục.
            a.btn-outline.h-14.px-8.text-base.rounded-full.mt-8.transition-transform.active_scale-95(href='/catalog') Xóa tất cả bộ lọc