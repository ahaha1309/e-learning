extends ../layouts/admin

include ../../layouts/mixins

block admin-content
  .max-w-5xl.mx-auto.space-y-6.animate-in.fade-in(style='animation-duration: 400ms;')
    +pgHeader({ eyebrow: 'Thông báo & Hoạt động', icon: 'ph-bold ph-bell', scale: 'compact', h1: 'Thông báo', subtitle: 'Quản lý các thông báo và cập nhật trên toàn hệ thống.' })

    if notifications && notifications.length > 0
      .bento-card.p-0.overflow-hidden
        .divide-y.divide-border
          each notification in notifications
            article.p-5.transition-colors(class='hover_bg-muted/30', class=notification.isRead ? '' : 'bg-primary/5 border-l-2 border-l-primary')
              .flex.items-start.justify-between.gap-4
                .flex.items-start.gap-4
                  if notification.isRead
                    .w-10.h-10.rounded-full.bg-muted.flex.items-center.justify-center.text-muted-foreground.flex-shrink-0
                      i.ph-fill.ph-bell.text-lg
                  else
                    div.w-10.h-10.rounded-full.flex.items-center.justify-center.text-primary.flex-shrink-0(class='bg-primary/10')
                      i.ph-fill.ph-bell-ringing.text-lg
                  div
                    h3.text-sm.font-bold(class=notification.isRead ? 'text-foreground' : 'text-primary')= notification.title
                    p.text-sm.text-muted-foreground.mt-1= notification.message
                    p.text-xs.font-medium.text-muted-foreground.mt-3= notification.createdAt ? new Date(notification.createdAt).toLocaleString('en-GB', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) : 'N/A'
                //- if !notification.isRead
                //-   button.btn-ghost.btn-sm.rounded-full.text-muted-foreground.hover_text-primary(title="Đánh dấu là đã đọc")
                //-     i.ph-bold.ph-check
    else
      +emptyState({ icon: 'ph-fill ph-bell-slash', title: 'Không có thông báo mới!', desc: 'Bạn không có thông báo nào mới vào lúc này.' })