extends ../layouts/admin

block admin-content
  .max-w-7xl.mx-auto.space-y-6.animate-in.fade-in(style='animation-duration: 400ms;')
    header.flex.flex-col.md_flex-row.md_items-end.justify-between.gap-4
      div
        p.eyebrow Danh mục Người dùng
        h1.text-3xl.font-extrabold.tracking-tight Người dùng
        p.text-muted-foreground.mt-2.text-sm Quản lý quyền truy cập nền tảng và vai trò.
      .flex.items-center.gap-3
        a.btn-outline.h-10.px-4.rounded-lg(href='/admin/users/export')
          i.ph-bold.ph-download-simple
          | Xuất
        a.btn-primary.h-10.px-4.rounded-lg.shadow-sm(href='/admin/users/new')
          i.ph-bold.ph-plus
          | Thêm Người dùng

    .bento-card.p-0.overflow-hidden.flex.flex-col
      //- Toolbar
      .p-4.border-b.border-border.bg-card.flex.flex-col.sm_flex-row.items-center.justify-between.gap-4
        form.flex-1.flex.flex-col.sm_flex-row.gap-3.w-full(method='GET', action='/admin/users')
          .relative.flex-1.max-w-md
            i.ph-bold.ph-magnifying-glass.absolute.left-3.text-muted-foreground(class='top-1/2 -translate-y-1/2')
            input.w-full.pl-10.h-10.rounded-lg.border.border-input.bg-background.text-sm.focus-visible_ring-1.focus-visible_ring-primary(type='search', name='q', value=query || '', placeholder='Tìm kiếm theo tên hoặc email...')
          
          .flex.items-center.gap-3
            select.h-10.rounded-lg.border.border-input.bg-background.text-sm.px-3(name='role', onchange='this.form.submit()')
              option(value='', selected=!roleFilter) Tất cả Vai trò
              option(value='student', selected=roleFilter === 'student') Học sinh
              option(value='teacher', selected=roleFilter === 'teacher') Giảng viên
              option(value='admin', selected=roleFilter === 'admin') Quản trị viên
            select.h-10.rounded-lg.border.border-input.bg-background.text-sm.px-3(name='status', onchange='this.form.submit()')
              option(value='', selected=!statusFilter) Tất cả Trạng thái
              option(value='active', selected=statusFilter === 'active') Hoạt động
              option(value='pending', selected=statusFilter === 'pending') Chờ duyệt
              option(value='rejected', selected=statusFilter === 'rejected') Bị từ chối

      //- Data Table
      if loading
        .table-wrap.shadow-sm(aria-busy='true', aria-label='Đang tải người dùng')
          table.w-full.text-left.text-sm
            thead.border-b.border-border(class='bg-muted/50')
              tr
                th.px-6.py-3: .skeleton.rounded(class='!h-4 !w-4')
                th.px-6.py-3
                th.px-6.py-3.hidden.md_table-cell: .skeleton.skeleton-text-short
                th.px-6.py-3.hidden.lg_table-cell: .skeleton.skeleton-text-short
                th.px-6.py-3.hidden.xl_table-cell: .skeleton.skeleton-text-short
                th.px-6.py-3
            tbody.divide-y.divide-border
              - var skeletonRows = [1,2,3,4,5,6,7,8]
              each _ in skeletonRows
                tr
                  td.px-6.py-4: .skeleton.rounded(class='!h-4 !w-4')
                  td.px-6.py-4
                    .flex.items-center.gap-3
                      .skeleton.skeleton-avatar(class='!w-10 !h-10 !rounded-full')
                      .space-y-2
                        .skeleton.skeleton-text(class='!w-40')
                        .skeleton.skeleton-text-short(class='!w-56')
                  td.px-6.py-4.hidden.md_table-cell: .skeleton.rounded-full(class='!h-5 !w-20')
                  td.px-6.py-4.hidden.lg_table-cell
                    .flex.items-center.gap-2
                      .skeleton.rounded-full(class='!h-2 !w-2')
                      .skeleton.skeleton-text-short(class='!w-16')
                  td.px-6.py-4.hidden.xl_table-cell: .skeleton.skeleton-text-short(class='!w-24')
                  td.px-6.py-4
                    .flex.gap-1.justify-end
                      .skeleton.rounded-lg(class='!h-8 !w-8')
                      .skeleton.rounded-lg(class='!h-8 !w-8')
                      .skeleton.rounded-lg(class='!h-8 !w-8')
      else if users && users.length > 0
        .table-wrap.shadow-sm
            table.w-full.text-left.text-sm
              thead.border-b.border-border(class='bg-muted/50')
                tr
                  th.px-6.py-3.font-semibold.text-xs.uppercase.tracking-wider.text-muted-foreground.w-10
                    input(type='checkbox', class='rounded border-input')
                  th.px-6.py-3.font-semibold.text-xs.uppercase.tracking-wider.text-muted-foreground Người dùng
                  th.px-6.py-3.font-semibold.text-xs.uppercase.tracking-wider.text-muted-foreground.hidden.md_table-cell Vai trò
                  th.px-6.py-3.font-semibold.text-xs.uppercase.tracking-wider.text-muted-foreground.hidden.lg_table-cell Trạng thái
                  th.px-6.py-3.font-semibold.text-xs.uppercase.tracking-wider.text-muted-foreground.hidden.xl_table-cell Ngày tham gia
                  th.px-6.py-3.text-center.font-semibold.text-xs.uppercase.tracking-wider.text-muted-foreground Thao tác
              tbody.divide-y.divide-border
                each user in users
                  tr.group.transition-colors(class='hover_bg-muted/30')
                    td.px-6.py-4
                      input(type='checkbox', class='rounded border-input', value=user.id)
                    td.px-6.py-4
                      .flex.items-center.gap-3
                        div.w-10.h-10.rounded-full.text-primary.flex.items-center.justify-center.font-bold.flex-shrink-0(class='bg-primary/10')
                          if user.avatarUrl
                            img.w-full.h-full.rounded-full.object-cover(src=user.avatarUrl, alt=user.name)
                          else
                            = user.name ? user.name.charAt(0).toUpperCase() : '?'
                        .flex-1.min-w-0
                          p.text-sm.font-bold.text-foreground.truncate= user.name
                          p.text-xs.text-muted-foreground.truncate= user.email
                    td.px-6.py-4.hidden.md_table-cell
                      if user.role === 'admin'
                        span.badge-warning.badge-sm.capitalize.shadow-sm= user.role
                      else if user.role === 'teacher'
                        span.badge-primary.badge-sm.capitalize.shadow-sm= user.role
                      else
                        span.badge-muted.badge-sm.capitalize.shadow-sm= user.role
                    td.px-6.py-4.hidden.lg_table-cell
                      if user.status === 'active'
                        .flex.items-center.gap-2
                          .w-2.h-2.rounded-full.bg-success
                          span.text-sm.text-foreground.capitalize= user.status
                      else if user.status === 'pending'
                        .flex.items-center.gap-2
                          .w-2.h-2.rounded-full.bg-warning.animate-pulse
                          span.text-sm.text-foreground.capitalize= user.status
                      else
                        .flex.items-center.gap-2
                          .w-2.h-2.rounded-full.bg-destructive
                          span.text-sm.text-foreground.capitalize= user.status
                    td.px-6.py-4.hidden.xl_table-cell
                      span.text-sm.text-muted-foreground= user.createdAt ? new Date(user.createdAt).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) : 'N/A'
                    td.px-6.py-4.text-right
                      .flex.items-center.justify-end.gap-1
                        a.p-2.inline-flex.rounded-lg.text-muted-foreground.transition-colors(
                          href='/admin/users/' + user.id,
                          class='hover_bg-info/10 hover_text-info',
                          aria-label='Xem ' + user.name,
                          title='Xem'
                        )
                          i.ph-bold.ph-eye.text-base
                        a.p-2.inline-flex.rounded-lg.text-muted-foreground.transition-colors(
                          href='/admin/users/' + user.id + '/edit',
                          class='hover_bg-primary/10 hover_text-primary',
                          aria-label='Sửa ' + user.name,
                          title='Sửa'
                        )
                          i.ph-bold.ph-pencil-simple.text-base
                        form(method='POST', action='/admin/users/' + user.id + '/delete', style='display:inline')
                          input(type='hidden', name='_csrf', value=csrfToken)
                          button.p-2.inline-flex.rounded-lg.text-muted-foreground.transition-colors(
                            type='submit',
                            class='hover_bg-destructive/10 hover_text-destructive',
                            aria-label='Xóa ' + user.name,
                            title='Xóa',
                            data-confirm='',
                            data-confirm-title='Xóa người dùng',
                            data-confirm-body='Xóa vĩnh viễn ' + user.name + '? Không thể hoàn tác hành động này.'
                          )
                            i.ph-bold.ph-trash.text-base

        //- Pagination Footer
        if totalPages > 1
          div.px-6.py-4.border-t.border-border.flex.items-center.justify-between(class='bg-muted/20')
            p.text-sm.text-muted-foreground Đang hiển thị trang <span class="font-bold text-foreground">#{currentPage}</span> trong <span class="font-bold text-foreground">#{totalPages}</span>
            .flex.items-center.gap-1
              if currentPage > 1
                a.btn-outline.h-8.w-8.p-0.rounded-lg(href='/admin/users?page=' + (currentPage - 1) + '&q=' + (query || '') + '&role=' + (roleFilter || '') + '&status=' + (statusFilter || ''))
                  i.ph-bold.ph-caret-left
              - for (var i = Math.max(1, currentPage - 2); i <= Math.min(totalPages, currentPage + 2); i++)
                a.h-8.w-8.p-0.rounded-lg.flex.items-center.justify-center.text-sm.font-medium.transition-colors(class=currentPage === i ? 'bg-primary text-primary-foreground shadow-sm' : 'hover_bg-muted text-muted-foreground', href='/admin/users?page=' + i + '&q=' + (query || '') + '&role=' + (roleFilter || '') + '&status=' + (statusFilter || ''))= i
              if currentPage < totalPages
                a.btn-outline.h-8.w-8.p-0.rounded-lg(href='/admin/users?page=' + (currentPage + 1) + '&q=' + (query || '') + '&role=' + (roleFilter || '') + '&status=' + (statusFilter || ''))
                  i.ph-bold.ph-caret-right

      else
        .empty-state.border-0.rounded-none.bg-transparent.py-16
          .w-16.h-16.rounded-2xl.bg-muted.flex.items-center.justify-center.mb-4
            i.ph-fill.ph-users.text-3xl(class='text-muted-foreground/50')
          h2.text-lg.font-bold.text-foreground Không tìm thấy người dùng nào
          p.text-sm.text-muted-foreground.mt-1 Điều chỉnh bộ lọc hoặc từ khóa tìm kiếm của bạn.
          a.btn-primary.mt-6(href='/admin/users/new')
            i.ph-bold.ph-plus
            | Thêm Người dùng Đầu tiên