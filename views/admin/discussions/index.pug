extends ../layouts/admin

block admin-content
  .max-w-7xl.mx-auto.space-y-6.animate-in.fade-in(style='animation-duration: 400ms;')
    header.flex.flex-col.md_flex-row.md_items-end.justify-between.gap-4
      div
        p.eyebrow Danh mục Thảo luận
        h1.text-3xl.font-extrabold.tracking-tight Thảo luận
        p.text-muted-foreground.mt-2.text-sm Xem tất cả các chủ đề thảo luận trên nền tảng.
      form.flex-1.flex.max-w-md(method='GET', action='/admin/discussions')
        .relative.w-full
          i.ph-bold.ph-magnifying-glass.absolute.left-3.text-muted-foreground(class='top-1/2 -translate-y-1/2')
          input.w-full.pl-10.h-10.rounded-lg.border.border-input.bg-background.text-sm.focus-visible_ring-1.focus-visible_ring-primary(type='search', name='q', value=query || '', placeholder='Tìm kiếm thảo luận...')

    if topics && topics.length > 0
      .grid.grid-cols-1.md_grid-cols-2.gap-6
        each topic in topics
          article.bento-card.p-6.flex.flex-col.gap-4
            .flex.items-start.gap-4
              div.w-12.h-12.rounded-full.text-primary.flex.items-center.justify-center.font-bold.flex-shrink-0(class='bg-primary/10')
                if topic.author && topic.author.avatarUrl
                  img.w-full.h-full.rounded-full.object-cover(src=topic.author.avatarUrl, alt=topic.author.name)
                else
                  = topic.author && topic.author.name ? topic.author.name.charAt(0).toUpperCase() : 'U'
              .flex-1.min-w-0
                .flex.items-start.justify-between.gap-3
                  div
                    h3.text-lg.font-bold.text-foreground.line-clamp-2= topic.title
                    p.text-sm.text-muted-foreground.mt-1
                      span.font-medium.text-foreground= topic.author ? topic.author.name : 'Không rõ'
                      |  đã đăng vào #{topic.createdAt ? topic.createdAt.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) : 'N/A'}
                  if topic.isPinned
                    span.badge-primary.badge-sm.shadow-sm
                      i.ph-fill.ph-push-pin.text-xs.mr-1
                      | Đã ghim
            
            .mt-auto.pt-4.border-t.border-border.flex.items-center.justify-between
              .flex.items-center.gap-2.text-sm.text-muted-foreground
                i.ph-fill.ph-chat-circle.text-lg
                span <strong class="text-foreground">#{topic.replyCount || 0}</strong> phản hồi
              a.btn-outline.h-8.px-3.text-xs.rounded-lg(href='/admin/discussions/' + topic.id)
                i.ph-bold.ph-arrow-right.text-xs.mr-1
                | Xem luồng

    else
      .empty-state.bento-card.py-20
        .w-16.h-16.rounded-2xl.bg-muted.flex.items-center.justify-center.mb-4
          i.ph-fill.ph-chats.text-3xl(class='text-muted-foreground/50')
        h2.text-lg.font-bold.text-foreground Không tìm thấy thảo luận nào
        p.text-sm.text-muted-foreground.mt-1 Chưa có chủ đề thảo luận nào được tạo.