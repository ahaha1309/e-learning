extends ../layouts/admin

block admin-content
  .max-w-7xl.mx-auto.space-y-8.animate-in.fade-in
    header.flex.flex-col.md_flex-row.md_items-end.justify-between.gap-4
      div
        p.eyebrow Luồng Thảo luận
        h1.text-3xl.font-extrabold.tracking-tight= topic.title
        p.text-muted-foreground.mt-2
          | bởi #{topic.author ? topic.author.name : 'Không rõ'}
          if topic.classroom
            |  trong #{topic.classroom.name}
          |  &middot; #{topic.createdAt ? new Date(topic.createdAt).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) : 'N/A'}
      a.btn-outline.h-10.px-4.rounded-lg(href='/admin/discussions')
        i.ph-bold.ph-arrow-left
        | Quay lại

    .grid.grid-cols-1.lg_grid-cols-3.gap-6
      .lg_col-span-2.space-y-6
        .bento-card.p-6
          if topic.author
            .flex.items-center.gap-3.mb-4
              .w-10.h-10.rounded-full.text-primary.flex.items-center.justify-center.font-bold(class='bg-primary/10')
                if topic.author.avatarUrl
                  img.w-full.h-full.rounded-full.object-cover(src=topic.author.avatarUrl, alt=topic.author.name)
                else
                  span= topic.author.name.charAt(0).toUpperCase()
              div
                p.text-sm.font-bold= topic.author.name
                p.text-xs.text-muted-foreground= topic.author.email

          .text-sm.text-foreground.leading-relaxed.mt-4.prose.max-w-none
            p= topic.content || 'Không có nội dung'

          if topic.isPinned
            .mt-4
              span.badge-primary.badge-sm
                i.ph-bold.ph-push-pin.text-xs.mr-1
                | Đã ghim

        .bento-card.p-6
          h2.text-lg.font-bold.mb-4 Phản hồi (#{replies.length})
          if replies.length
            .space-y-4
              each reply in replies
                .border.rounded-xl.p-4(class='border-border/60')
                  .flex.items-center.gap-3.mb-3
                    .w-8.h-8.rounded-full.text-muted-foreground.flex.items-center.justify-center.text-xs.font-bold(class='bg-muted')
                      if reply.author && reply.author.avatarUrl
                        img.w-full.h-full.rounded-full.object-cover(src=reply.author.avatarUrl, alt=reply.author.name)
                      else
                        span= reply.author ? reply.author.name.charAt(0).toUpperCase() : '?'
                    div
                      p.text-sm.font-medium= reply.author ? reply.author.name : 'Không rõ'
                      p.text-xs.text-muted-foreground= reply.createdAt ? new Date(reply.createdAt).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) : ''
                  p.text-sm.leading-relaxed= reply.content
          else
            .empty-state.py-8.border-0.bg-transparent
              p.text-sm.text-muted-foreground Chưa có phản hồi nào.

      .space-y-6
        .bento-card.p-6.space-y-4
          h2.text-lg.font-bold Chi tiết
          .flex.items-center.justify-between
            span.text-sm.text-muted-foreground Tác giả
            span.text-sm.font-medium= topic.author ? topic.author.name : 'Không rõ'
          .flex.items-center.justify-between
            span.text-sm.text-muted-foreground Lớp học
            span.text-sm.font-medium= topic.classroom ? topic.classroom.name : 'N/A'
          .flex.items-center.justify-between
            span.text-sm.text-muted-foreground Phản hồi
            span.text-sm.font-mono.font-bold= topic.replyCount || 0
          .flex.items-center.justify-between
            span.text-sm.text-muted-foreground Ngày tạo
            span.text-sm= topic.createdAt ? new Date(topic.createdAt).toLocaleDateString('en-GB') : 'N/A'
          if topic.isPinned
            .flex.items-center.justify-between
              span.text-sm.text-muted-foreground Đã ghim
              span.badge-primary.badge-sm Có
