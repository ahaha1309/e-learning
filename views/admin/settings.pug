    script.
      (function () {
        var form = document.querySelector('[data-settings-form="true"]');
        if (!form) return;
        var submitBtn = form.querySelector('[data-settings-submit="true"]');
        var uploading = form.querySelector('[data-settings-uploading="true"]');

        // Live image preview on file selection for logo & favicon.
        ['logo', 'favicon'].forEach(function (field) {
          var input = document.getElementById(field);
          if (!input) return;
          input.addEventListener('change', function () {
            var file = input.files && input.files[0];
            if (!file) return;
            var preview = form.querySelector('[data-' + field + '-preview="true"]');
            var currentImg = preview ? preview.querySelector('img') : null;
            var reader = new FileReader();
            reader.onload = function (e) {
              if (currentImg) { currentImg.src = e.target.result; }
            };
            reader.readAsDataURL(file);
          });
        });

        form.addEventListener('submit', function () {
          if (submitBtn) { submitBtn.disabled = true; }
          if (uploading) { uploading.classList.remove('hidden'); }
        });
      })();
