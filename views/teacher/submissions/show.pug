extends ../../layouts/base

block content
  .page.space-y-8
    .flex.gap-3.flex-wrap.items-center
      a.pill(href='/teacher/classrooms/' + classroom.id + '/assignments/' + assignment.id + '/submissions') Quay lại các bài nộp
      a.pill(href='/teacher/classrooms/' + classroom.id + '/assignments/' + assignment.id) Quay lại bài tập
      form(method='POST', action='/teacher/classrooms/' + classroom.id + '/assignments/' + assignment.id + '/submissions/' + submission.id + '/delete', onsubmit='return confirm("Xóa bài nộp này? Học sinh sẽ có thể nộp lại.");')
        input(type='hidden', name='_csrf', value=csrfToken)
        button.pill.text-destructive.border-destructive(type='submit', class='hover_bg-destructive/10')
          i.ph-bold.ph-trash
          | Xóa bài nộp

    .grid.grid-cols-1.gap-8.items-start(class='lg_grid-cols-[minmax(0,1.2fr)_minmax(320px,0.8fr)]')
      div
        p.eyebrow Giảng viên
        h1.text-3xl.font-bold.tracking-tight= 'Bài nộp của ' + submission.student.name
        p.text-muted-foreground.mt-2= submission.student.email
      aside.card.p-5
        p.text-sm.text-muted-foreground Trạng thái
        strong.text-2xl.font-mono.capitalize= submission.status
        p.text-sm.text-muted-foreground.mt-3 Bài tập: #{assignment.title}

    if errorMessage
      .alert-danger= errorMessage

    if assignment.type === 'quiz'
      .card.p-6
        p.text-lg.font-bold.mb-4 Bài nộp Trắc nghiệm
        if submission.answers && submission.answers.length > 0
          .space-y-4
            - var pointPerQuestion = submission.answers.length > 0 ? (assignment.totalPoints / submission.answers.length) : 0;
            each ans, index in submission.answers
              if ans.question
                .p-4.border.rounded-xl(class=ans.isCorrect ? 'border-success/30 bg-success/5' : 'border-destructive/30 bg-destructive/5')
                  p.text-sm.font-bold Câu #{index + 1}: !{ans.question.content}
                  
                  if ans.question.type === 'essay'
                    p.mt-2.text-sm.text-muted-foreground.font-medium Trả lời:
                    p.mt-1.text-sm.whitespace-pre-wrap= ans.text
                  else
                    ul.mt-2.text-sm.space-y-1
                      each opt in ans.question.options
                        - var isSelected = ans.selectedOptions && ans.selectedOptions.includes(opt.id)
                        li(class=isSelected ? 'font-bold text-foreground' : 'text-muted-foreground')
                          if isSelected
                            i.ph-fill.ph-check-circle(class=opt.isCorrect ? 'text-success' : 'text-destructive')
                          else if opt.isCorrect
                            i.ph-bold.ph-check.text-success
                          |  #{opt.text}
                  p.mt-2.text-xs.font-bold(class=ans.isCorrect ? 'text-success' : 'text-destructive')
                    | Đạt #{ans.pointsAchieved} / #{pointPerQuestion.toFixed(2)} điểm
        else
          p.text-sm.text-muted-foreground Không có câu trả lời nào được lưu.
    else
      .card.p-6
        p.text-lg.font-bold.mb-2 Câu trả lời của học sinh
        p.text-foreground.whitespace-pre-wrap.leading-relaxed= submission.textAnswer || 'Chưa có câu trả lời bằng văn bản.'

      if submission.attachment && submission.attachment.url
        .card.p-5
          p.text-sm.font-medium.mb-2 Tệp đính kèm
          a.pill(href=submission.attachment.url, target='_blank', rel='noreferrer') Mở tệp

    if assignment.rubric
      .card.p-6.space-y-4
        .flex.items-center.justify-between.pb-3.border-b.border-border(class='border-border/60 flex-wrap gap-3')
          .flex.items-center.gap-3
            .w-10.h-10.rounded-xl.flex.items-center.justify-center.text-primary(class='bg-primary/10')
              i.ph-bold.ph-check-square-offset.text-xl
            div
              h3.text-lg.font-bold= 'Chấm điểm bằng Rubric: ' + (assignment.rubric.name || 'Rubric')
              p.text-xs.text-muted-foreground= (assignment.rubric.criteria ? assignment.rubric.criteria.length : 0) + ' tiêu chí đánh giá — Tối đa ' + assignment.rubric.maxPoints + ' điểm'
          a.btn-primary.btn-glow.h-11.px-5.rounded-full.inline-flex.items-center.gap-2.text-sm.font-bold(href='/teacher/classrooms/' + classroom.id + '/assignments/' + assignment.id + '/submissions/' + submission.id + '/grade-rubric')
            i.ph-bold.ph-pencil-line
            | Mở giao diện chấm Rubric

        if rubricCriterionGrades && rubricCriterionGrades.length
          .space-y-3.pt-2
            p.text-xs.font-bold.uppercase.tracking-widest.text-muted-foreground Kết quả chấm từng tiêu chí hiện tại:
            .divide-y.divide-border(class='divide-border/50 border rounded-xl overflow-hidden')
              each cg in rubricCriterionGrades
                .p-4.flex.items-baseline.justify-between.gap-4.bg-card(class='hover_bg-muted/30')
                  div
                    p.text-sm.font-bold.text-foreground= cg.label
                    if cg.description
                      p.text-xs.text-muted-foreground(class='mt-0.5')= cg.description
                  .text-right.flex-shrink-0
                    if cg.awardedPoints !== null
                      span.font-mono.text-base.font-black.text-primary= cg.awardedPoints
                      span.text-xs.text-muted-foreground= ' / ' + cg.maxPoints + ' điểm'
                    else
                      span.badge-muted.text-xs Chưa cho điểm

    form.card.p-6(method='POST', action='/teacher/classrooms/' + classroom.id + '/assignments/' + assignment.id + '/submissions/' + submission.id + '/grade').space-y-4
      input(type='hidden', name='_csrf', value=csrfToken)
      div
        label.text-sm.font-medium(for='score') Điểm
        input#score.mt-2(type='number', min='0', step='0.5', name='score', value=submission.score === null ? '' : submission.score, required)
      div
        label.text-sm.font-medium(for='teacherComment') Nhận xét
        textarea#teacherComment.mt-2(name='teacherComment', rows='4')= submission.teacherComment || ''
      .flex.gap-3.flex-wrap
        button.btn-primary(type='submit') Lưu điểm
        a.pill(href='/teacher/classrooms/' + classroom.id + '/assignments/' + assignment.id + '/submissions') Quay lại các bài nộp