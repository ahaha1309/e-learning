//- ── TEACHER ANALYTICS DASHBOARD ────────────────────────────────────────
//- vars: classroom, studentCount, topStudents, atRiskStudents, latestExam,
//-       attendanceRate, avgScore, submissionRate, currentUser

extends ../../layouts/base

block content
  .page.max-w-7xl.pt-8.pb-24.space-y-10

    //- ── PAGE HEADER ─────────────────────────────────────────────────────
    header.flex.flex-col.md_flex-row.md_items-end.justify-between.gap-6.animate-in.slide-in-up

      div
        .flex.items-center.gap-2.mb-3
          a.text-xs.font-bold.text-muted-foreground.transition-colors(
            href='/teacher/classrooms/' + classroom.id,
            class='hover_text-primary'
          )= classroom.name
          i.ph-bold.ph-caret-right.text-xs.text-muted-foreground(aria-hidden='true')
          span.text-xs.font-bold.text-primary Phân tích
        h1.text-3xl.font-extrabold.tracking-tight Hiệu suất Lớp học
        p.text-muted-foreground.mt-1 Tổng quan thời gian thực về hoạt động và kết quả của học sinh.

      .flex.items-center.gap-3.flex-shrink-0
        a.btn-outline.h-10.px-5.rounded-xl(href='/teacher/classrooms/' + classroom.id)
          i.ph-bold.ph-arrow-left(aria-hidden='true')
          | Quay lại

    //- ── KPI STRIP ───────────────────────────────────────────────────────
    //- Asymmetric grid: 4 KPIs using divide-y / divide-x (no card overuse)
    .glass-panel.rounded-2xl.overflow-hidden.animate-in.slide-in-up(style='animation-delay: 100ms;')
      .grid.grid-cols-2.lg_grid-cols-4.divide-y.lg_divide-y-0.lg_divide-x.divide-border

        //- Total Students
        .p-6.transition-colors.group(class='hover_bg-muted/30')
          .flex.items-center.justify-between.mb-3
            span.font-bold.uppercase.tracking-widest.text-muted-foreground(style='font-size:0.625rem;line-height:0.875rem;letter-spacing:0.02em') Tổng số học sinh
            .w-9.h-9.rounded-xl.flex.items-center.justify-center.transition-colors(class='bg-muted group-hover_bg-primary/10')
              i.ph-bold.ph-users.text-base.text-muted-foreground(class='group-hover_text-primary', aria-hidden='true')
          p.text-4xl.font-mono.font-bold.tracking-tighter= studentCount || 0

        //- Average Score
        .p-6.transition-colors.group(class='hover_bg-muted/30')
          .flex.items-center.justify-between.mb-3
            span.font-bold.uppercase.tracking-widest.text-muted-foreground(style='font-size:0.625rem;line-height:0.875rem;letter-spacing:0.02em') Điểm trung bình
            .w-9.h-9.rounded-xl.flex.items-center.justify-center.transition-colors(class='bg-muted group-hover_bg-success/10')
              i.ph-bold.ph-chart-line-up.text-base.text-muted-foreground(class='group-hover_text-success', aria-hidden='true')
          .flex.items-end.gap-2
            p.text-4xl.font-mono.font-bold.tracking-tighter= avgScore != null ? avgScore.toFixed(1) : '--'
            span.text-lg.font-mono.text-muted-foreground.mb-1 %

        //- Attendance Rate
        .p-6.transition-colors.group(class='hover_bg-muted/30')
          .flex.items-center.justify-between.mb-3
            span.font-bold.uppercase.tracking-widest.text-muted-foreground(style='font-size:0.625rem;line-height:0.875rem;letter-spacing:0.02em') Điểm danh
            .w-9.h-9.rounded-xl.flex.items-center.justify-center.transition-colors(class='bg-muted group-hover_bg-warning/10')
              i.ph-bold.ph-calendar-check.text-base.text-muted-foreground(class='group-hover_text-warning', aria-hidden='true')
          .flex.items-end.gap-2
            p.text-4xl.font-mono.font-bold.tracking-tighter= attendanceRate != null ? attendanceRate.toFixed(1) : '--'
            span.text-lg.font-mono.text-muted-foreground.mb-1 %

        //- At-Risk Count
        .p-6.transition-colors.group(class='hover_bg-muted/30')
          .flex.items-center.justify-between.mb-3
            span.font-bold.uppercase.tracking-widest.text-muted-foreground(style='font-size:0.625rem;line-height:0.875rem;letter-spacing:0.02em') Nguy cơ
            .w-9.h-9.rounded-xl.flex.items-center.justify-center.transition-colors(class='bg-muted group-hover_bg-destructive/10')
              i.ph-bold.ph-warning-circle.text-base.text-muted-foreground(class='group-hover_text-destructive', aria-hidden='true')
          .flex.items-end.gap-2
            p.text-4xl.font-mono.font-bold.tracking-tighter= atRiskStudents ? atRiskStudents.length : 0
            if atRiskStudents && atRiskStudents.length > 0
              span.badge.badge-danger.badge-sm.mb-1 Cần hành động

    //- ── MAIN DATA GRID (asymmetric 2/3 + 1/3) ───────────────────────────
    .grid.grid-cols-1.lg_grid-cols-3.gap-6.animate-in.slide-in-up(style='animation-delay: 200ms;')

      //- LEFT: Grade distribution chart (2/3 width)
      .lg_col-span-2
        .glass-panel.rounded-2xl.p-6.h-full
          .flex.items-center.justify-between.mb-6
            div
              h2.text-lg.font-bold.tracking-tight Phân bố điểm
              if latestExam
                p.text-sm.text-muted-foreground(class='mt-0.5')= latestExam.title
              else
                p.text-sm.text-muted-foreground(class='mt-0.5') Chưa có dữ liệu bài thi
            if latestExam
              span.badge.badge-muted= (latestExam.distribution && latestExam.distribution.labels) ? latestExam.distribution.labels.length + ' khoảng' : ''

          if latestExam && latestExam.distribution && latestExam.distribution.hasData
            .relative(style='height: 300px;')
              canvas#grade-chart(aria-label='Grade distribution bar chart', role='img')
          else
            //- Empty state
            .flex.flex-col.items-center.justify-center.py-16.gap-3.text-center
              .w-14.h-14.rounded-2xl.flex.items-center.justify-center.bg-muted
                i.ph-bold.ph-chart-bar.text-2xl.text-muted-foreground(aria-hidden='true')
              h3.text-base.font-bold Chưa có dữ liệu bài thi
              p.text-sm.text-muted-foreground Chưa có học sinh nào hoàn thành hoặc được chấm điểm bài thi này.

      //- RIGHT: Student leaderboard (1/3 width)
      .space-y-4

        //- Top performers
        .glass-panel.rounded-2xl.p-5
          .flex.items-center.gap-2.mb-4
            i.ph-fill.ph-trophy.text-lg.text-success(aria-hidden='true')
            h3.text-sm.font-bold.tracking-tight Thành tích Tốt nhất

          if topStudents && topStudents.length
            ol.space-y-2(aria-label='Top performing students')
              each student, idx in topStudents
                li.flex.items-center.gap-3.p-3.rounded-xl.transition-colors(class='hover_bg-muted/50')
                  span.w-5.h-5.rounded-full.flex.items-center.justify-center.font-bold.flex-shrink-0(
                    style='font-size:0.625rem;line-height:0.875rem;letter-spacing:0.02em',
                    class=idx === 0 ? 'bg-success/15 text-success' : 'bg-muted text-muted-foreground'
                  )= idx + 1
                  .flex-1.min-w-0
                    p.text-sm.font-semibold.truncate= student.studentId.name
                  span.font-mono.text-sm.font-bold.flex-shrink-0(
                    class=student.averagePercentage >= 80 ? 'text-success' : 'text-foreground'
                  )= student.averagePercentage.toFixed(1) + '%'
          else
            .py-6.text-center
              p.text-sm.text-muted-foreground Chưa đủ dữ liệu bài thi.

        //- At-risk students
        .glass-panel.rounded-2xl.p-5
          .flex.items-center.gap-2.mb-4
            i.ph-fill.ph-warning-circle.text-lg.text-destructive(aria-hidden='true')
            h3.text-sm.font-bold.tracking-tight Nguy cơ
            span.text-muted-foreground(style='font-size:0.625rem;line-height:0.875rem;letter-spacing:0.02em') (dưới 50%)

          if atRiskStudents && atRiskStudents.length
            ol.space-y-2(aria-label='Students at risk')
              each student in atRiskStudents
                li.flex.items-center.gap-3.p-3.rounded-xl.transition-colors(class='hover_bg-muted/50')
                  .avatar.avatar-sm.flex-shrink-0.bg-destructive(class='bg-destructive/10 text-destructive', aria-hidden='true')
                    i.ph-bold.ph-user.text-xs
                  .flex-1.min-w-0
                    p.text-sm.font-semibold.truncate= student.studentId.name
                  span.font-mono.text-sm.font-bold.text-destructive.flex-shrink-0= student.averagePercentage.toFixed(1) + '%'
          else
            .py-6.flex.flex-col.items-center.gap-2.text-center
              i.ph-bold.ph-check-circle.text-3xl.text-success(aria-hidden='true')
              p.text-sm.font-bold.text-success Không có học sinh nguy cơ
              p.text-xs.text-muted-foreground Tất cả học sinh đạt trên 50%.

    //- ── SUBMISSION RATE PROGRESS BARS (below charts) ─────────────────────
    if submissionRate != null
      .glass-panel.rounded-2xl.p-6.animate-in.slide-in-up(style='animation-delay: 300ms;')
        .flex.items-center.justify-between.mb-6
          h2.text-lg.font-bold.tracking-tight Hoàn thành Bài tập
          span.text-sm.font-mono.font-bold.text-muted-foreground= submissionRate.toFixed(1) + '% TB'

        .grid.grid-cols-1.md_grid-cols-2.gap-5
          div
            .flex.items-center.justify-between.mb-2
              span.text-sm.font-medium.text-muted-foreground Bài nộp đã nhận
              span.font-mono.text-sm.font-bold= submissionRate != null ? submissionRate.toFixed(1) + '%' : '--'
            .progress
              .progress-bar(
                style='width: ' + (submissionRate || 0) + '%;',
                role='progressbar',
                aria-valuenow=submissionRate || 0,
                aria-valuemin='0',
                aria-valuemax='100',
                aria-label='Submission rate'
              )
          div
            .flex.items-center.justify-between.mb-2
              span.text-sm.font-medium.text-muted-foreground Tỷ lệ điểm danh
              span.font-mono.text-sm.font-bold= attendanceRate != null ? attendanceRate.toFixed(1) + '%' : '--'
            .progress
              .progress-bar(
                style='width: ' + (attendanceRate || 0) + '%;',
                role='progressbar',
                aria-valuenow=attendanceRate || 0,
                aria-valuemin='0',
                aria-valuemax='100',
                aria-label='Attendance rate'
              )

  //- ── CHART.JS ──────────────────────────────────────────────────────────
  if latestExam && latestExam.distribution && latestExam.distribution.hasData
    script(src='https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js')
    script.
      (function () {
        var ctx     = document.getElementById('grade-chart');
        var isDark  = document.documentElement.classList.contains('dark');
        var prefersReducedMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var labels  = !{JSON.stringify(latestExam.distribution.labels)};
        var data    = !{JSON.stringify(latestExam.distribution.data)};

        var accent  = isDark ? 'hsla(150,60%,45%,0.75)' : 'hsla(150,60%,38%,0.75)';
        var accentB = isDark ? 'hsl(150,60%,45%)' : 'hsl(150,60%,38%)';
        var gridC   = isDark ? 'rgba(148,163,184,0.1)' : 'rgba(15,23,42,0.06)';
        var labelC  = isDark ? '#94a3b8' : '#64748b';

        new Chart(ctx, {
          type: 'bar',
          data: {
            labels: labels,
            datasets: [{
              label: 'Students',
              data: data,
              backgroundColor: accent,
              borderColor: accentB,
              borderWidth: 1,
              borderRadius: 6,
              borderSkipped: false
            }]
          },
          options: {
            animation: prefersReducedMotion ? false : undefined,
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              legend: { display: false },
              tooltip: {
                callbacks: {
                  label: function (ctx) { return ' ' + ctx.parsed.y + ' học sinh'; }
                }
              }
            },
            scales: {
              y: {
                beginAtZero: true,
                ticks: { stepSize: 1, color: labelC, font: { family: 'Geist Mono, monospace', size: 11 } },
                grid: { color: gridC }
              },
              x: {
                ticks: { color: labelC, font: { family: 'Geist, system-ui, sans-serif', size: 12 } },
                grid: { display: false }
              }
            }
          }
        });
      })();

block scripts