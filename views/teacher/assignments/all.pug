extends ../../layouts/base

include ../../layouts/mixins

block content
  .page.space-y-8
    nav.breadcrumb.mb-6
      a(href='/teacher/dashboard') Dashboard
      span.breadcrumb-sep /
      span.text-foreground.font-bold Tất cả bài tập

    +pgHeader({ eyebrow: 'Giảng viên', icon: 'ph-bold ph-file-text', h1: 'Tất cả bài tập', subtitle: 'Xem và quản lý bài tập từ tất cả các lớp học của bạn.' })
      aside.glass-panel.rounded-2xl.p-5.flex.items-center.gap-4(class='border-border/60')
        .w-10.h-10.rounded-xl.flex.items-center.justify-center.text-primary(class='bg-primary/10')
          i.ph-bold.ph-stack.text-lg
        div
          p.text-xs.font-bold.text-muted-foreground.uppercase.tracking-widest Tổng bài tập
          p.font-mono.text-3xl.font-bold.tracking-tighter= assignments.length

    .flex.gap-2.flex-wrap
      a.pill(href='/teacher/classrooms')
        i.ph-bold.ph-chalkboard
        | Quản lý lớp học
      a.pill(href='/teacher/dashboard') Dashboard

    //- Search toolbar
    .bg-card.rounded-2xl.border.border-border.p-4.flex.flex-col.sm_flex-row.items-center.justify-between.gap-4
      form.flex-1.flex.flex-col.sm_flex-row.gap-3.w-full(method='GET', action='/teacher/assignments')
        .relative.flex-1.max-w-md
          i.ph-bold.ph-magnifying-glass.absolute.left-3.text-muted-foreground(class='top-1/2 -translate-y-1/2')
          input.w-full.pl-10.h-10.rounded-lg.border.border-input.bg-background.text-sm.focus-visible_ring-1.focus-visible_ring-primary(
            type='search', name='q', value=query || '', placeholder='Tìm kiếm bài tập...'
          )
        button.btn-primary.h-10.px-4.rounded-lg(type='submit') Tìm kiếm

    if assignments.length
      .space-y-3.animate-in.slide-in-up(style='animation-delay:100ms;')
        each assignment in assignments
          article.card.p-5.card-hover
            .flex.justify-between.gap-4.flex-wrap
              div
                .flex.items-center.gap-2.mb-1
                  if assignment.classroom
                    a.badge-muted.badge-sm(href='/teacher/classrooms/' + assignment.classroom._id)= assignment.classroom.name
                  if assignment.isOverdue
                    span.badge-sm(style='background:hsl(var(--destructive)/0.15);color:hsl(var(--destructive))') Quá hạn
                  else if !assignment.isPublished
                    span.badge-muted.badge-sm Bản nháp
                h2.text-lg.font-bold.mb-1= assignment.title
                p.text-sm.text-muted-foreground= assignment.description || 'Chưa có mô tả.'
              span.badge-muted.badge-sm= assignment.totalPoints + ' điểm'
            .flex.flex-wrap.gap-4.text-sm.text-muted-foreground.mt-3
              if assignment.dueDate
                span Hạn chót: #{new Date(assignment.dueDate).toLocaleString('vi-VN')}
              span Xuất bản: #{assignment.isPublished ? 'Có' : 'Không'}
            if assignment.classroom
              .mt-3
                a.pill(href='/teacher/classrooms/' + assignment.classroom._id + '/assignments/' + assignment._id)
                  i.ph-bold.ph-arrow-right
                  | Xem chi tiết
    else
      +emptyState({ icon: 'ph-fill ph-file-code', title: 'Chưa có bài tập nào', desc: 'Vào lớp học của bạn để tạo bài tập mới.' })
        a.btn-primary.btn-sm.mt-6(href='/teacher/classrooms')
          i.ph-bold.ph-chalkboard
          | Xem lớp học
