extends ../../layouts/base

block content
  .page-narrow.max-w-7xl.space-y-12.pt-8.pb-32
    header.flex.flex-col.md_flex-row.md_items-end.justify-between.gap-8.animate-in.slide-in-up
      div
        nav.breadcrumb.animate-in.fade-in.mb-6
          a(href='/teacher') Bảng điều khiển
          span.breadcrumb-sep /
          a(href='/teacher/classrooms') Lớp học
          span.breadcrumb-sep /
          a(href='/teacher/classrooms/' + classroom.id)= classroom.name
          span.breadcrumb-sep /
          a(href='/teacher/classrooms/' + classroom.id + '/assignments') Bài tập
          span.breadcrumb-sep /
          span.text-foreground.font-bold Bài tập mới

        .inline-flex.items-center.gap-2.rounded-full.border.text-primary.text-xs.font-bold.uppercase.tracking-widest.px-4.mb-6(class='py-1.5 bg-primary/5 border-primary/20') Studio Sáng tạo
        h1.text-4xl.md_text-5xl.font-extrabold.tracking-tighter Trình tạo Bài tập
        p.text-lg.text-muted-foreground.mt-3 Tạo bài tập có cấu trúc với hạn chót, điểm số và yêu cầu tệp tùy chọn.

      .flex.items-center.gap-4
        a.btn-outline.h-14.px-6.rounded-full(class='hover_bg-muted/50', href='/teacher/classrooms/' + classroom.id + '/assignments')
          i.ph-bold.ph-x.text-lg
          | Hủy

    form.grid.grid-cols-1.lg_grid-cols-12.gap-12.animate-in.slide-in-up(style='animation-delay: 100ms;', method='POST', action='/teacher/classrooms/' + classroom.id + '/assignments', enctype='multipart/form-data')
      input(type='hidden', name='_csrf', value=csrfToken)

      //- Main Content Col
      .lg_col-span-8.space-y-8
        if errorMessage
          .alert-danger.rounded-2xl= errorMessage

        //- Step 1: Basic Info
        .glass-panel.p-8.space-y-8(class='rounded-[2rem] border-border/60')
          .flex.items-center.gap-3.pb-4.border-b(class='border-border/60')
            .w-10.h-10.rounded-lg.flex.items-center.justify-center(class='bg-primary/10 text-primary')
              span.font-bold.text-sm 1
            h3.text-lg.font-bold Thông tin cơ bản & Đính kèm

          .space-y-2
            label.text-sm.font-bold.uppercase.tracking-widest.text-muted-foreground(for='title') Tiêu đề Bài tập
            input#title.w-full.h-14.px-5.rounded-xl.bg-background.border.text-lg.font-bold(class='border-border/60 focus_ring-2 focus_ring-primary focus_border-transparent', type='text', name='title', value=formData.title || '', placeholder='ví dụ: Thiết kế REST API — Bài tập về nhà', required)

          .space-y-2
            label.text-sm.font-bold.uppercase.tracking-widest.text-muted-foreground(for='type') Loại Bài tập
            select#type.w-full.h-14.px-5.rounded-xl.bg-background.border.font-medium.appearance-none(class='border-border/60 focus_ring-2 focus_ring-primary focus_border-transparent', name='type')
              option(value='upload', selected=(formData.type !== 'quiz')) Nộp tệp đính kèm
              option(value='quiz', selected=(formData.type === 'quiz')) Trắc nghiệm

          .space-y-2
            label.text-sm.font-bold.uppercase.tracking-widest.text-muted-foreground(for='description') Mô tả Ngắn
            input#description.w-full.h-14.px-5.rounded-xl.bg-background.border.font-medium(class='border-border/60 focus_ring-2 focus_ring-primary focus_border-transparent', type='text', name='description', value=formData.description || '', placeholder='Tóm tắt ngắn gọn hiển thị trong danh sách bài tập')

          .space-y-2
            label.text-sm.font-bold.uppercase.tracking-widest.text-muted-foreground(for='instructions') Hướng dẫn Chi tiết
            textarea#instructions.tinymce.w-full.px-5.py-4.rounded-xl.bg-background.border.font-medium.resize-y(class='border-border/60 focus_ring-2 focus_ring-primary focus_border-transparent', name='instructions', rows='8', placeholder='Cung cấp hướng dẫn từng bước, yêu cầu, hướng dẫn định dạng và bất kỳ tài nguyên nào học sinh cần...')= formData.instructions || ''

          #attachment-block.space-y-2
            label.text-sm.font-bold.uppercase.tracking-widest.text-muted-foreground(for='attachmentFiles') Tệp đính kèm / File Hướng dẫn (Tùy chọn)
            input#attachmentFiles.w-full.p-3.rounded-xl.bg-background.border.font-medium(class='border-border/60 focus_ring-2 focus_ring-primary focus_border-transparent', type='file', name='attachmentFiles', multiple=true)
            p.text-xs.text-muted-foreground Cho phép tải lên tệp đính kèm hướng dẫn (PDF, Word, Excel, PowerPoint, Ảnh, Text, Code, ZIP...). Tối đa 5 tệp, 50MB/tệp.

        //- Step 2: Grading & Timeline
        .glass-panel.p-8.space-y-8(class='rounded-[2rem] border-border/60')
          .flex.items-center.gap-3.pb-4.border-b(class='border-border/60')
            .w-10.h-10.rounded-lg.flex.items-center.justify-center(class='bg-warning/10 text-warning')
              span.font-bold.text-sm 2
            h3.text-lg.font-bold Chấm điểm & Thời gian

          .grid.grid-cols-1.md_grid-cols-2.gap-6
            .space-y-2
              label.text-sm.font-bold.uppercase.tracking-widest.text-muted-foreground(for='totalPoints') Tổng điểm
              input#totalPoints.w-full.h-14.px-5.rounded-xl.bg-background.border.font-medium(class='border-border/60 focus_ring-2 focus_ring-primary focus_border-transparent', type='number', min='0', step='0.5', name='totalPoints', value=formData.totalPoints || 10, required)
              p.text-xs.text-muted-foreground Điểm số tối đa có thể đạt được.

            .space-y-2
              label.text-sm.font-bold.uppercase.tracking-widest.text-muted-foreground(for='dueDate') Ngày & Giờ Hạn chót
              input#dueDate.w-full.h-14.px-5.rounded-xl.bg-background.border.font-medium(class='border-border/60 focus_ring-2 focus_ring-primary focus_border-transparent', type='datetime-local', name='dueDate', value=formData.dueDate || '', required)
              p.text-xs.text-muted-foreground Các bài nộp sau thời gian này được đánh dấu là nộp muộn.

          .space-y-2
            label.text-sm.font-bold.uppercase.tracking-widest.text-muted-foreground(for='allowLateSubmission') Chính sách Nộp muộn
            select#allowLateSubmission.w-full.h-14.px-5.rounded-xl.bg-background.border.font-medium.appearance-none(class='border-border/60 focus_ring-2 focus_ring-primary focus_border-transparent', name='allowLateSubmission')
              option(value='false', selected=(formData.allowLateSubmission || 'false') !== 'true') Không cho phép nộp muộn
              option(value='true', selected=formData.allowLateSubmission === 'true') Cho phép nộp muộn (bị trừ điểm)

      //- Sidebar Config Col
      .lg_col-span-4.space-y-8
        .glass-panel.p-8.space-y-8(class='rounded-[2rem] border-border/60')
          .flex.items-center.gap-3.pb-4.border-b(class='border-border/60')
            .w-10.h-10.rounded-lg.flex.items-center.justify-center(class='bg-success/10 text-success')
              i.ph-bold.ph-rocket-launch.text-xl
            h3.text-lg.font-bold Xuất bản

          .space-y-4
            label.group.flex.items-center.gap-4.p-4.rounded-xl.border.cursor-pointer.transition-all.duration-150(class='border-border/60 hover_border-primary hover_bg-primary/5')
              .relative.flex-shrink-0
                input#isPublished.peer.sr-only(type='checkbox', name='isPublished', value='true', checked=(formData.isPublished || 'true') !== 'false')
                .w-5.h-5.rounded-md.border-2.transition-all(class='border-muted-foreground peer-checked_border-primary peer-checked_bg-primary')
                i.ph-bold.ph-check.absolute.inset-0.flex.items-center.justify-center.text-white.text-xs.opacity-0.scale-50.transition-all(class='peer-checked_opacity-100 peer-checked_scale-100', aria-hidden='true')
              div
                p.text-sm.font-bold.text-foreground Xuất bản ngay
                p.text-xs.text-muted-foreground Hiển thị cho học sinh ngay lập tức.

          button.btn-primary.w-full.h-14.rounded-xl.text-base.font-bold.shadow-diffused.active_scale-95.transition-transform(type='submit')
            i.ph-bold.ph-file-plus.text-lg
            | Tạo Bài tập

        .glass-panel.p-8.space-y-8(class='rounded-[2rem] border-border/60')
          .flex.items-center.gap-3.pb-4.border-b(class='border-border/60')
            .w-10.h-10.rounded-lg.flex.items-center.justify-center(class='bg-info/10 text-info')
              i.ph-bold.ph-info.text-xl
            h3.text-lg.font-bold Tóm tắt

          .space-y-3.text-sm
            .flex.items-center.justify-between
              span.text-muted-foreground Lớp học
              span.font-medium= classroom.name
            .flex.items-center.justify-between
              span.text-muted-foreground Điểm
              span.font-mono.font-bold#summary-points= formData.totalPoints || 10
            .flex.items-center.justify-between
              span.text-muted-foreground Nộp muộn
              span.font-medium#summary-late Không cho phép
            .flex.items-center.justify-between
              span.text-muted-foreground Xuất bản
              span.font-medium#summary-publish Có

    script(src='https://cdnjs.cloudflare.com/ajax/libs/tinymce/7.1.1/tinymce.min.js', referrerpolicy='origin')
    script(src='/js/tinymce-config.js')
    script.
      document.addEventListener('DOMContentLoaded', function() {
        var pointsInput = document.getElementById('totalPoints');
        var lateSelect = document.getElementById('allowLateSubmission');
        var publishCheck = document.getElementById('isPublished');
        if (pointsInput) pointsInput.addEventListener('input', function() {
          document.getElementById('summary-points').textContent = this.value || 0;
        });
        if (lateSelect) lateSelect.addEventListener('change', function() {
          document.getElementById('summary-late').textContent = this.value === 'true' ? 'Cho phép' : 'Không cho phép';
        });
        if (publishCheck) publishCheck.addEventListener('change', function() {
          document.getElementById('summary-publish').textContent = this.checked ? 'Có' : 'Không';
        });

        var typeSelect = document.getElementById('type');
        var attachmentBlock = document.getElementById('attachment-block');
        if (typeSelect && attachmentBlock) {
          const toggleAttachment = () => {
            attachmentBlock.style.display = typeSelect.value === 'quiz' ? 'none' : 'block';
          };
          typeSelect.addEventListener('change', toggleAttachment);
          toggleAttachment();
        }
      });
