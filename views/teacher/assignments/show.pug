extends ../../layouts/base

block content
  .page.space-y-8
    .grid.grid-cols-1.gap-8.items-start(class='lg_grid-cols-[minmax(0,1.2fr)_minmax(320px,0.8fr)]')
      div
        p.eyebrow Giảng viên
        h1.text-3xl.font-bold.tracking-tight= assignment.title
        p.text-muted-foreground.max-w-prose.mt-2= assignment.description || 'Chưa có mô tả.'
      aside.card.p-5
        p.text-sm.text-muted-foreground Hạn chót
        strong.text-2xl.font-mono= assignment.dueDate.toLocaleString('en-GB')
        p.text-sm.text-muted-foreground.mt-3 Điểm: #{assignment.totalPoints}

    .card.p-6
      p.text-lg.font-bold.mb-4 Hướng dẫn
      if assignment.instructions
        div.text-foreground.leading-relaxed.space-y-2!= assignment.instructions
      else
        p.text-muted-foreground Chưa có hướng dẫn.

    if assignment.rubric
      .card.p-6.space-y-4
        .flex.items-center.justify-between.pb-3.border-b.border-border(class='border-border/60 flex-wrap gap-2')
          .flex.items-center.gap-2
            .w-8.h-8.rounded-lg.flex.items-center.justify-center(class='bg-primary/10 text-primary')
              i.ph-bold.ph-check-square-offset
            div
              p.text-xs.font-bold.uppercase.tracking-widest.text-muted-foreground Tiêu chuẩn chấm điểm
              h3.text-lg.font-bold= assignment.rubric.name
          .flex.items-center.gap-3
            span.badge-muted.badge-sm= (assignment.rubric.criteria ? assignment.rubric.criteria.length : 0) + ' tiêu chí (' + assignment.rubric.maxPoints + ' điểm)'
            a.pill.text-xs(href='/teacher/classrooms/' + classroom.id + '/rubrics/' + (assignment.rubric._id || assignment.rubric))
              i.ph-bold.ph-arrow-square-out
              | Chi tiết Rubric

        if assignment.rubric.description
          p.text-sm.text-muted-foreground= assignment.rubric.description

        if assignment.rubric.criteria && assignment.rubric.criteria.length
          .space-y-3
            each criterion in assignment.rubric.criteria
              .p-4.rounded-xl.border(class='border-border/50 bg-muted/20 space-y-2')
                .flex.items-baseline.justify-between.gap-2
                  p.text-sm.font-bold.text-foreground= criterion.label
                  span.font-mono.text-xs.font-bold.text-primary= '/ ' + criterion.maxPoints + ' điểm'
                if criterion.description
                  p.text-xs.text-muted-foreground= criterion.description
                if criterion.scale && criterion.scale.length
                  .flex.flex-wrap.pt-1(class='gap-1.5')
                    each sc in criterion.scale
                      span.pill.text-xs(class='py-0.5 px-2')= sc.points + 'đ — ' + sc.label

    if assignment.attachments && assignment.attachments.length > 0
      .card.p-6
        p.text-lg.font-bold.mb-4 Tệp đính kèm & File Hướng dẫn từ Giảng viên
        .grid.grid-cols-1.sm_grid-cols-2.gap-4
          each file in assignment.attachments
            a.flex.items-center.justify-between.p-4.rounded-2xl.border.transition-all(href=file.fileUrl, download=true, target='_blank', class='bg-muted/40 border-border/60 hover_bg-muted/80 hover_border-primary/40')
              .flex.items-center.gap-3.min-w-0
                .w-10.h-10.rounded-xl.flex.items-center.justify-center.font-black.uppercase.text-xs.flex-shrink-0(class='bg-primary/10 text-primary')
                  = file.fileType || 'FILE'
                .min-w-0
                  p.text-sm.font-bold.text-foreground.truncate= file.fileName
                  p.text-xs.text-muted-foreground= Math.round((file.fileSize || 0) / 1024) + ' KB'
              .w-8.h-8.rounded-lg.bg-background.flex.items-center.justify-center.text-muted-foreground
                i.ph-bold.ph-download-simple.text-base

    .flex.gap-3.flex-wrap
      if assignment.type === 'quiz'
        a.pill(href='/teacher/classrooms/' + classroom.id + '/assignments/' + assignment.id + '/questions')
          i.ph-bold.ph-list-checks
          | Quản lý Câu hỏi
      a.pill(href='/teacher/classrooms/' + classroom.id + '/assignments/' + assignment.id + '/submissions') Đánh giá bài nộp
      a.pill(href='/teacher/classrooms/' + classroom.id + '/assignments/' + assignment.id + '/edit')
        i.ph-bold.ph-pencil-simple
        | Chỉnh sửa & Gia hạn thời gian
      a.pill(href='/teacher/classrooms/' + classroom.id + '/assignments') Quay lại các bài tập
      a.pill(href='/teacher/classrooms/' + classroom.id) Quay lại lớp học