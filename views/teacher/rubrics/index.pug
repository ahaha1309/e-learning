extends ../../layouts/base

include ../../layouts/mixins

block content
  .page.space-y-8
    nav.breadcrumb.mb-6
      a(href='/teacher/classrooms') Lớp học
      span.breadcrumb-sep /
      a(href='/teacher/classrooms/' + classroom.id)= classroom.name
      span.breadcrumb-sep /
      a(href='/teacher/classrooms/' + classroom.id + '/assignments') Bài tập
      span.breadcrumb-sep /
      span.text-foreground.font-bold Tiêu chí chấm điểm (Rubric)

    +pgHeader({ eyebrow: 'Đánh giá & Chấm điểm', icon: 'ph-bold ph-check-square-offset', h1: 'Rubric ' + classroom.name, subtitle: 'Thiết lập tiêu chí đánh giá chuẩn xác, minh bạch giúp giảng viên chấm điểm nhanh và sinh viên định hướng rõ ràng.' })
      aside.glass-panel.rounded-2xl.p-5.flex.items-center.gap-4(class='border-border/60')
        .w-10.h-10.rounded-xl.flex.items-center.justify-center.text-primary(class='bg-primary/10')
          i.ph-bold.ph-list-checks.text-lg
        div
          p.text-xs.font-bold.text-muted-foreground.uppercase.tracking-widest Tổng số Rubric
          p.font-mono.text-3xl.font-bold.tracking-tighter= rubrics.length

    .flex.gap-2.flex-wrap
      a.btn-primary.btn-glow.h-11.px-5.rounded-full.inline-flex.items-center.gap-2.text-sm.font-bold(href='/teacher/classrooms/' + classroom.id + '/rubrics/new')
        i.ph-bold.ph-plus
        | Tạo Rubric mới
      a.pill(href='/teacher/classrooms/' + classroom.id + '/assignments')
        i.ph-bold.ph-stack
        | Danh sách Bài tập
      a.pill(href='/teacher/classrooms/' + classroom.id) Quay lại Lớp học

    if feedback
      .alert-success.animate-in.fade-in= feedback

    if errorMessage
      .alert-danger.animate-in.fade-in= errorMessage

    if rubrics.length
      .grid.grid-cols-1.lg_grid-cols-2.gap-6.animate-in.slide-in-up(style='animation-delay: 100ms;')
        each rubric in rubrics
          article.card.p-6.space-y-5.card-hover.flex.flex-col.justify-between
            div.space-y-4
              .flex.items-start.justify-between.gap-4
                div
                  h2.text-xl.font-bold.tracking-tight.text-foreground= rubric.name
                  p.text-sm.text-muted-foreground.mt-1= rubric.description || 'Chưa có mô tả ngắn.'
                span.inline-flex.items-center.gap-1.px-3.py-1.rounded-full.bg-primary.bg-opacity-10.text-primary.text-sm.font-bold.border.border-primary(class='border-opacity-20')
                  i.ph-bold.ph-trophy
                  = rubric.maxPoints + ' điểm'

              //- Criteria pill preview
              .space-y-2
                p.text-xs.font-bold.uppercase.tracking-widest.text-muted-foreground= (rubric.criteria ? rubric.criteria.length : 0) + ' tiêu chí đánh giá:'
                .flex.flex-wrap.gap-2
                  if rubric.criteria && rubric.criteria.length
                    each criterion in rubric.criteria
                      span.badge-muted.badge-sm.inline-flex.items-center(class='gap-1.5')
                        i.ph-bold.ph-check-circle.text-primary
                        span.font-medium= criterion.label
                        span.text-muted-foreground.font-bold= '(' + criterion.maxPoints + 'đ)'

              //- Assignment usage info
              .pt-3.border-t.border-border(class='border-border/60 text-xs text-muted-foreground flex items-center justify-between')
                span.inline-flex.items-center(class='gap-1.5')
                  i.ph-bold.ph-link
                  if rubric.assignmentCount > 0
                    | Đang gắn với #{rubric.assignmentCount} bài tập
                  else
                    | Chưa gắn với bài tập nào
                span.font-mono Tạo lúc #{new Date(rubric.createdAt).toLocaleDateString('vi-VN')}

            //- Action buttons
            .pt-4.border-t.border-border(class='border-border/60 flex items-center justify-between gap-3 flex-wrap')
              .flex.items-center.gap-2
                a.pill(href='/teacher/classrooms/' + classroom.id + '/rubrics/' + rubric._id)
                  i.ph-bold.ph-eye
                  | Chi tiết
                a.pill(href='/teacher/classrooms/' + classroom.id + '/rubrics/' + rubric._id + '/edit')
                  i.ph-bold.ph-pencil-simple
                  | Sửa

              .flex.items-center.gap-2
                form(method='POST', action='/teacher/classrooms/' + classroom.id + '/rubrics/' + rubric._id + '/duplicate')
                  input(type='hidden', name='_csrf', value=csrfToken)
                  button.pill(type='submit', title='Nhân bản Rubric này')
                    i.ph-bold.ph-copy
                    | Nhân bản
                form(method='POST', action='/teacher/classrooms/' + classroom.id + '/rubrics/' + rubric._id + '/delete', onsubmit='return confirm("Bạn có chắc chắn muốn xóa Rubric này? Nếu có bài tập đang dùng, liên kết rubric sẽ bị hủy.");')
                  input(type='hidden', name='_csrf', value=csrfToken)
                  button.pill.text-destructive.border-destructive(type='submit', class='hover_bg-destructive/10', title='Xóa Rubric')
                    i.ph-bold.ph-trash
                    | Xóa
    else
      +emptyState({ icon: 'ph-fill ph-list-checks', title: 'Chưa có Rubric nào', desc: 'Tạo ma trận tiêu chí đánh giá đầu tiên để áp dụng chấm điểm cho các bài tập trong lớp học.' })
        .mt-4
          a.btn-primary.h-12.px-6.rounded-full.inline-flex.items-center.gap-2.font-bold(href='/teacher/classrooms/' + classroom.id + '/rubrics/new')
            i.ph-bold.ph-plus
            | Tạo Rubric đầu tiên
