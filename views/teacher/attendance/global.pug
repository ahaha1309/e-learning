extends ../../layouts/base

block content
  .page-narrow.max-w-7xl.pt-8.pb-32.space-y-10
    .animate-in.slide-in-up
      p.eyebrow Giảng viên
      h1.text-3xl.font-extrabold.tracking-tight Điểm danh
      p.text-muted-foreground.mt-2 Chọn một lớp học để quản lý các buổi điểm danh.

    if classrooms.length
      .grid.grid-cols-1.md_grid-cols-2.lg_grid-cols-3.gap-6.animate-in.slide-in-up(style='animation-delay: 150ms;')
        each classroom in classrooms
          a.glass-panel.p-6.rounded-2xl.border.border-border.transition-all.duration-200(
            href='/teacher/classrooms/' + classroom.id + '/attendance',
            class='hover_bg-muted/30 hover_shadow-md hover_-translate-y-0.5'
          )
            .flex.items-center.gap-4.mb-4
              .w-12.h-12.rounded-xl.flex.items-center.justify-center(class='bg-warning/10')
                i.ph-bold.ph-calendar-check.text-xl(style='color:hsl(var(--warning))')
              div
                h3.text-base.font-bold.tracking-tight= classroom.name
                p.text-xs.text-muted-foreground Mã: #{classroom.code}
            .flex.items-center.justify-between.text-sm
              span.text-muted-foreground Quản lý điểm danh
              i.ph-bold.ph-arrow-right(style='color:hsl(var(--warning))')
    else
      .empty-state.animate-in.fade-in(style='animation-delay: 200ms;')
        .w-16.h-16.rounded-xl.bg-muted.flex.items-center.justify-center.mb-4
          i.ph-bold.ph-calendar-check.text-3xl.text-muted-foreground
        h2.text-xl.font-bold.text-foreground Chưa có lớp học nào
        p.text-sm.text-muted-foreground.mt-2 Tạo một lớp học để bắt đầu theo dõi điểm danh.
        a.btn-primary.btn-sm.mt-6(href='/teacher/classrooms/new')
          i.ph-bold.ph-plus
          | Tạo Lớp học
