extends ../../layouts/base

block content
  .page.space-y-8
    p.eyebrow Giảng viên
    h1.text-3xl.font-bold.tracking-tight Buổi Điểm danh
    p.text-muted-foreground.mt-2 Lớp học: #{classroom.name}

    if feedback
      .alert-success= feedback

    .flex.flex-wrap.gap-3
      a.pill(href='/teacher/classrooms/' + classroom.id) Quay lại Lớp học
      form(method='POST', action='/teacher/classrooms/' + classroom.id + '/attendance', class='inline-flex flex-wrap gap-3')
        input(type='hidden', name='_csrf', value=csrfToken)
        button.btn-primary(type='submit', name='method', value='code')
          i.ph-bold.ph-password
          | Bắt đầu bằng Mã 6 số
        button.btn-primary(type='submit', name='method', value='qr')
          i.ph-bold.ph-qr-code
          | Bắt đầu bằng Mã QR

    if sessions.length
      .space-y-3.mt-4
        each session in sessions
          article.card.p-5.flex.justify-between.items-center
            div
              p.font-medium= session.date.toLocaleDateString('en-GB')
              p.text-sm.text-muted-foreground.mt-1 Hình thức: #{session.method === 'qr' ? 'Mã QR' : 'Mã 6 số'}
              p.text-sm.text-muted-foreground.mt-1 Trạng thái:
                if session.status === 'open'
                  span.text-success.font-bold  Mở
                else
                  span.text-destructive  Đóng
            .flex.gap-2
              if session.status === 'open'
                a.pill(href='/teacher/classrooms/' + classroom.id + '/attendance/' + session.id + '/live') Tiếp tục Trực tiếp
              a.pill(href='/teacher/classrooms/' + classroom.id + '/attendance/' + session.id + '/records') Xem Bản ghi
    else
      .empty-state
        .w-16.h-16.rounded-xl.bg-muted.flex.items-center.justify-center.mb-4
          i.ph-bold.ph-clipboard-text.text-3xl.text-muted-foreground
        h2.text-xl.font-bold.text-foreground Chưa có buổi điểm danh nào
        p.text-sm.text-muted-foreground.mt-2 Chọn "Bắt đầu bằng Mã 6 số" hoặc "Bắt đầu bằng Mã QR" để bắt đầu.