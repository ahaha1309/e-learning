extends ../../layouts/base

block content
  //- Hidden meta for JS
  #ai-generate-meta(
    data-exam-id=exam.id,
    data-classroom-id=classroom.id,
    data-csrf=csrfToken,
    data-import-url='/teacher/classrooms/' + classroom.id + '/exams/' + exam.id + '/import-questions',
    data-generate-url='/teacher/classrooms/' + classroom.id + '/exams/' + exam.id + '/ai-generate',
    hidden
  )

  .page.space-y-10

    //- ── Page header ────────────────────────────────────────────────────────
    header.flex.flex-col.md_flex-row.md_items-end.justify-between.gap-6.animate-in.slide-in-up

      div
        nav.breadcrumb.mb-4
          a(href='/teacher') Bảng điều khiển
          span.breadcrumb-sep /
          a(href='/teacher/classrooms') Lớp học
          span.breadcrumb-sep /
          a(href='/teacher/classrooms/' + classroom.id)= classroom.name
          span.breadcrumb-sep /
          a(href='/teacher/classrooms/' + classroom.id + '/exams') Bài thi
          span.breadcrumb-sep /
          a(href='/teacher/classrooms/' + classroom.id + '/exams/' + exam.id)= exam.title
          span.breadcrumb-sep /
          span.text-foreground.font-bold Tạo câu hỏi bằng AI

        h1.text-3xl.font-extrabold.tracking-tighter
          i.ph-bold.ph-sparkle.text-primary.mr-2(aria-hidden='true')
          | Tạo câu hỏi bằng AI
        p.text-muted-foreground.mt-2.max-w-prose
          | Tải lên tài liệu học tập, cấu hình tham số, và Gemini AI sẽ tạo câu hỏi trắc nghiệm dựa trên nội dung thực tế của tài liệu.

      a.btn-outline.rounded-full(href='/teacher/classrooms/' + classroom.id + '/exams/' + exam.id + '/questions')
        i.ph-bold.ph-x(aria-hidden='true')
        | Hủy

    //- ── Step indicators ─────────────────────────────────────────────────────
    .import-steps(role='list')
      button#step-upload-indicator.import-step(data-active='true', role='listitem', aria-current='step')
        .import-step-num 1
        span Tải lên Tài liệu
      span.import-step-sep(aria-hidden='true')
      button#step-config-indicator.import-step(data-active='false', role='listitem')
        .import-step-num 2
        span Cấu hình
      span.import-step-sep(aria-hidden='true')
      button#step-preview-indicator.import-step(data-active='false', role='listitem')
        .import-step-num 3
        span Xem lại & Chỉnh sửa
      span.import-step-sep(aria-hidden='true')
      button#step-confirm-indicator.import-step(data-active='false', role='listitem')
        .import-step-num 4
        span Lưu vào Bài thi

    //- ── STEP 1: Upload ──────────────────────────────────────────────────────
    section#step-upload.glass-panel.p-8.rounded-2xl.space-y-6

      h2.text-lg.font-bold Định dạng được hỗ trợ

      .grid.grid-cols-2.gap-3(class='sm_grid-cols-4')
        .flex.items-center.gap-3.p-4.rounded-xl.border.border-border.bg-muted(class='bg-opacity-40')
          .w-10.h-10.rounded-lg.flex.items-center.justify-center(class='bg-destructive/10')
            i.ph-bold.ph-file-pdf.text-xl.text-destructive(aria-hidden='true')
          div
            p.text-sm.font-bold PDF
            p.text-xs.text-muted-foreground Tối đa 30 MB
        .flex.items-center.gap-3.p-4.rounded-xl.border.border-border.bg-muted(class='bg-opacity-40')
          .w-10.h-10.rounded-lg.flex.items-center.justify-center(class='bg-info/10')
            i.ph-bold.ph-file-doc.text-xl.text-info(aria-hidden='true')
          div
            p.text-sm.font-bold DOCX
            p.text-xs.text-muted-foreground Word 2007+
        .flex.items-center.gap-3.p-4.rounded-xl.border.border-border.bg-muted(class='bg-opacity-40')
          .w-10.h-10.rounded-lg.flex.items-center.justify-center(class='bg-success/10')
            i.ph-bold.ph-file-text.text-xl.text-success(aria-hidden='true')
          div
            p.text-sm.font-bold TXT
            p.text-xs.text-muted-foreground Văn bản thuần
        .flex.items-center.gap-3.p-4.rounded-xl.border.border-border.bg-muted(class='bg-opacity-40')
          .w-10.h-10.rounded-lg.flex.items-center.justify-center(class='bg-warning/10')
            i.ph-bold.ph-file-ppt.text-xl.text-warning(aria-hidden='true')
          div
            p.text-sm.font-bold PPTX
            p.text-xs.text-muted-foreground Slide PowerPoint

      //- Drop zone
      button#ai-drop-zone.import-drop-zone(
        type='button',
        aria-label='Nhấp hoặc kéo thả tệp tài liệu vào đây'
      )
        #ai-spinner.import-spinner(hidden, aria-hidden='true')
          i.ph-bold.ph-circle-notch.text-3xl.text-primary.animate-spin(aria-hidden='true')
        div(id='ai-drop-icon', aria-hidden='true')
          i.ph-bold.ph-upload-simple.text-4xl.text-muted-foreground
        p#ai-drop-text.text-base.font-semibold.mt-3 Thả tệp của bạn vào đây
        p.text-sm.text-muted-foreground.mt-1 hoặc nhấp để duyệt (PDF · DOCX · TXT · PPTX · Tối đa 30 MB)
        input#ai-file-input(type='file', accept='.pdf,.docx,.txt,.pptx', hidden, aria-hidden='true')

      //- Selected file info
      #ai-file-info.hidden.p-4.rounded-xl.border.border-primary(class='bg-primary/5')
        .flex.items-center.gap-3
          i.ph-bold.ph-file-text.text-2xl.text-primary(aria-hidden='true')
          div.flex-1.min-w-0
            p#ai-file-name.text-sm.font-semibold.truncate (chưa chọn)
            p#ai-file-size.text-xs.text-muted-foreground
          button#ai-remove-file.btn-ghost.btn-sm.btn-icon.text-destructive(
            type='button',
            aria-label='Xóa tệp đã chọn'
          )
            i.ph-bold.ph-x-circle.text-lg

      p#ai-upload-error.text-destructive.text-sm.font-medium.mt-2(hidden)

      .flex.justify-end.mt-4
        button#proceed-to-config.btn-primary.rounded-full.h-11.px-8(type='button', disabled)
          | Tiếp tục để Cấu hình
          i.ph-bold.ph-arrow-right(aria-hidden='true')

    //- ── STEP 2: Config ──────────────────────────────────────────────────────
    section#step-config.glass-panel.p-8.rounded-2xl.space-y-6(hidden)

      h2.text-lg.font-bold Cấu hình Tạo câu hỏi

      .grid.grid-cols-1.gap-6(class='md_grid-cols-2')

        div
          label.text-sm.font-semibold.mb-2.block(for='ai-num-questions')
            i.ph-bold.ph-list-numbers.text-primary.mr-1(aria-hidden='true')
            | Số câu hỏi cần tạo
          .flex.items-center.gap-3
            input#ai-num-questions.w-24(
              type='number',
              name='numQuestions',
              value='5',
              min='1',
              max='50',
              step='1'
            )
            span.text-sm.text-muted-foreground câu (tối đa 50)

        div
          label.text-sm.font-semibold.mb-2.block(for='ai-difficulty')
            i.ph-bold.ph-chart-bar.text-primary.mr-1(aria-hidden='true')
            | Độ khó
          select#ai-difficulty(name='difficulty')
            option(value='easy') Dễ — Nhận biết / Cơ bản
            option(value='medium', selected) Trung bình — Thông hiểu / Áp dụng
            option(value='hard') Khó — Phân tích / Vận dụng cao

        div
          label.text-sm.font-semibold.mb-2.block(for='ai-language')
            i.ph-bold.ph-translate.text-primary.mr-1(aria-hidden='true')
            | Ngôn ngữ câu hỏi
          select#ai-language(name='language')
            option(value='vi', selected) Tiếng Việt
            option(value='en') English

        div
          label.text-sm.font-semibold.mb-2.block(for='ai-num-options')
            i.ph-bold.ph-check-square.text-primary.mr-1(aria-hidden='true')
            | Số lựa chọn mỗi câu
          select#ai-num-options(name='numOptions')
            option(value='2') 2 lựa chọn (A, B)
            option(value='3') 3 lựa chọn (A, B, C)
            option(value='4', selected) 4 lựa chọn (A, B, C, D)
            option(value='5') 5 lựa chọn (A, B, C, D, E)

        div.col-span-full
          label.text-sm.font-semibold.mb-2.block(for='ai-focus-topic')
            i.ph-bold.ph-book-open.text-primary.mr-1(aria-hidden='true')
            | Chủ đề / Chương tập trung
            span.text-muted-foreground.font-normal  (Tùy chọn)
          input#ai-focus-topic(
            type='text',
            name='focusTopic',
            placeholder='Ví dụ: Chương 3 — Lập trình hướng đối tượng, Bài 5 — Mạng máy tính...',
            class='w-full'
          )
          p.text-xs.text-muted-foreground.mt-1 Để trống nếu muốn tạo câu hỏi từ toàn bộ tài liệu

        div.col-span-full
          label.inline-flex.items-center.gap-3.cursor-pointer
            input#ai-include-explanation(type='checkbox', name='includeExplanation', value='true', class='rounded border-border')
            div
              p.text-sm.font-semibold Tạo giải thích cho đáp án đúng
              p.text-xs.text-muted-foreground Gemini sẽ thêm giải thích ngắn cho mỗi câu hỏi (có thể xem trong phần xem lại)

      //- Generation warning
      .flex.items-start.gap-3.p-4.rounded-xl.border.border-warning(class='bg-warning/5')
        i.ph-bold.ph-info.text-warning.text-lg.mt-1.flex-shrink-0(aria-hidden='true')
        p.text-sm.text-muted-foreground
          strong.text-foreground Lưu ý:&nbsp;
          | Gemini AI sẽ tạo câu hỏi DỰA TRÊN NỘI DUNG tài liệu bạn tải lên. Hãy luôn xem lại và chỉnh sửa câu hỏi trước khi lưu vào bài thi.

      .flex.justify-between.gap-3.mt-2
        button#back-to-upload.btn-outline.rounded-full(type='button')
          i.ph-bold.ph-arrow-left(aria-hidden='true')
          | Quay lại
        button#start-generate.btn-primary.rounded-full.h-11.px-8(type='button')
          span#generate-spinner.hidden
            i.ph-bold.ph-circle-notch.animate-spin.mr-1(aria-hidden='true')
          i.ph-bold.ph-sparkle(aria-hidden='true')
          | Tạo câu hỏi với AI

    //- ── STEP 3: Preview & Edit ───────────────────────────────────────────────
    section#step-preview(hidden)

      .flex.flex-col.sm_flex-row.sm_items-center.justify-between.gap-4.mb-6
        div
          h2.text-xl.font-bold Xem lại Câu hỏi do AI tạo
          p#preview-count.text-sm.text-muted-foreground.mt-1

        .flex.gap-2
          button#regenerate-btn.btn-outline.rounded-full(type='button')
            i.ph-bold.ph-arrows-clockwise(aria-hidden='true')
            | Tạo lại

      p#preview-warnings.alert.alert-warning.mb-4(hidden)
      p#preview-error.alert.alert-danger.mb-4(hidden)

      #preview-list.space-y-4

      .flex.justify-between.gap-3.mt-8.pt-6.border-t.border-border
        button#back-to-config.btn-outline.rounded-full(type='button')
          i.ph-bold.ph-arrow-left(aria-hidden='true')
          | Quay lại Cấu hình
        button#proceed-to-confirm.btn-primary.rounded-full(type='button', disabled)
          | Tiếp tục để Lưu
          i.ph-bold.ph-arrow-right(aria-hidden='true')

    //- ── STEP 4: Confirm & Save ───────────────────────────────────────────────
    section#step-confirm.glass-panel.p-8.rounded-2xl.space-y-6(hidden)

      .flex.flex-col.items-center.text-center.gap-4.py-6
        .w-16.h-16.rounded-2xl.flex.items-center.justify-center(class='bg-primary/10')
          i.ph-bold.ph-check-circle.text-4xl.text-primary(aria-hidden='true')
        h2.text-2xl.font-bold Sẵn sàng lưu vào bài thi
        p.text-muted-foreground.max-w-sm
          span#confirm-count.font-bold.text-foreground 0
          |  câu hỏi đã được xem lại và sẵn sàng thêm vào
          span.font-bold.text-foreground  #{exam.title}.
        p.text-sm.text-muted-foreground Bạn vẫn có thể xóa hoặc chỉnh sửa từng câu hỏi sau khi lưu.

      p#save-error.alert.alert-danger(hidden)

      .flex.flex-col.sm_flex-row.gap-3.justify-center
        button#back-to-preview.btn-outline.h-12.px-6.rounded-full(type='button')
          i.ph-bold.ph-arrow-left(aria-hidden='true')
          | Quay lại Xem lại
        button#save-btn.btn-primary.h-12.px-8.rounded-full(type='button')
          span#save-spinner(hidden)
            i.ph-bold.ph-circle-notch.animate-spin(aria-hidden='true')
          i.ph-bold.ph-floppy-disk(aria-hidden='true')
          | Lưu vào Bài thi

  script(src='/js/ai-question-gen.js', defer)
