extends ../../layouts/base

include ../../layouts/mixins

block content
  .page.space-y-8
    nav.breadcrumb.mb-6
      a(href='/teacher/classrooms') Lớp học
      span.breadcrumb-sep /
      a(href='/teacher/classrooms/' + classroom.id)= classroom.name
      span.breadcrumb-sep /
      span.text-foreground.font-bold Bài thi

    +pgHeader({ eyebrow: 'Giảng viên', icon: 'ph-bold ph-chalkboard-teacher', h1: 'Bài thi của ' + classroom.name, subtitle: 'Tạo câu hỏi và bài thi cho lớp học của bạn.' })
      aside.glass-panel.rounded-2xl.p-5.flex.items-center.gap-4(class='border-border/60')
        .w-10.h-10.rounded-xl.flex.items-center.justify-center.text-warning(class='bg-warning/10')
          i.ph-bold.ph-exam.text-lg
        div
          p.text-xs.font-bold.text-muted-foreground.uppercase.tracking-widest Bài thi
          p.font-mono.text-3xl.font-bold.tracking-tighter= exams.length

    .flex.gap-3.flex-wrap
      a.pill(href='/teacher/classrooms/' + classroom.id + '/exams/new')
        i.ph-bold.ph-plus
        | Tạo bài thi
      a.pill(href='/teacher/classrooms/' + classroom.id) Quay lại lớp học

    if feedback
      .alert-success.animate-in.fade-in= feedback

    if exams.length
      .space-y-4.animate-in.slide-in-up(style='animation-delay:100ms;')
        each exam in exams
          article.card.p-5.card-hover
            .flex.justify-between.gap-4.flex-wrap
              div
                h2.text-lg.font-bold.mb-1= exam.title
                p.text-sm.text-muted-foreground= exam.description || 'Chưa có mô tả.'
              span.badge-muted.badge-sm.self-start= exam.totalPoints + ' điểm / ' + exam.questionCount + ' câu hỏi'
            .flex.gap-4.flex-wrap.text-sm.text-muted-foreground.mt-3
              span Thời lượng: #{exam.duration > 0 ? exam.duration + ' phút' : 'Không giới hạn'}
              span Đã xuất bản: #{exam.isPublished ? 'Có' : 'Không'}
            .mt-3
              a.pill(href='/teacher/classrooms/' + classroom.id + '/exams/' + exam.id)
                i.ph-bold.ph-arrow-right
                | Mở bài thi
    else
      +emptyState({ icon: 'ph-fill ph-exam', title: 'Chưa có bài thi nào', desc: 'Tạo bài thi đầu tiên để đánh giá học sinh của bạn.' })
