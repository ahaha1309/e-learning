  script.
    // AI Assistant
    const aiFab = document.getElementById('ai-fab');
    const aiPanel = document.getElementById('ai-panel');
    const aiClose = document.getElementById('ai-close');
    const aiIcon = document.getElementById('ai-fab-icon');
    const aiInput = document.getElementById('ai-input');
    const aiSend = document.getElementById('ai-send');
    const aiMessages = document.getElementById('ai-messages');

    let aiOpen = false;
    let aiLastTrigger = null;

    function toggleAI() {
      aiOpen = !aiOpen;
      if (aiOpen) {
        aiLastTrigger = document.activeElement;
        aiFab.classList.add('open');
        aiPanel.classList.add('open');
        aiFab.setAttribute('aria-expanded', 'true');
        aiIcon.className = 'ph-bold ph-x text-xl';
        setTimeout(() => aiInput.focus(), 300);
      } else {
        aiFab.classList.remove('open');
        aiPanel.classList.remove('open');
        aiFab.setAttribute('aria-expanded', 'false');
        aiIcon.className = 'ph-bold ph-sparkle text-xl';
        if (aiLastTrigger && typeof aiLastTrigger.focus === 'function') {
          try { aiLastTrigger.focus(); } catch (e) {}
          aiLastTrigger = null;
        }
      }
    }

    aiFab.addEventListener('click', toggleAI);
    aiClose.addEventListener('click', toggleAI);

    aiInput.addEventListener('input', () => {
      aiSend.disabled = aiInput.value.trim().length === 0;
    });

    aiInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey && aiInput.value.trim()) {
        e.preventDefault();
        sendAIMessage(aiInput.value.trim());
      }
    });

    aiSend.addEventListener('click', () => {
      if (aiInput.value.trim()) sendAIMessage(aiInput.value.trim());
    });

    function aiPrompt(text) {
      sendAIMessage(text);
    }

    function addAIMessage(content, role) {
      const div = document.createElement('div');
      div.className = 'ai-msg ai-msg-' + role;
      div.textContent = content;
      aiMessages.appendChild(div);
      aiMessages.scrollTop = aiMessages.scrollHeight;
      return div;
    }

    function addTypingIndicator() {
      const div = document.createElement('div');
      div.className = 'ai-typing-dot';
      div.innerHTML = '<span></span><span></span><span></span>';
      aiMessages.appendChild(div);
      aiMessages.scrollTop = aiMessages.scrollHeight;
      return div;
    }

    async function sendAIMessage(text) {
      aiInput.value = '';
      aiSend.disabled = true;
      addAIMessage(text, 'user');
      const typing = addTypingIndicator();

      // Simulated responses (replace with actual API call)
      const responses = {
        'explain a concept': 'Sure! Tell me which concept you\'d like me to explain, and I\'ll break it down step by step.',
        'quiz me': 'Great idea! Which subject or topic should I quiz you on?',
        'study tips': 'Here are some evidence-backed study tips: 1) Use spaced repetition — review material at increasing intervals. 2) Practice active recall instead of passive reading. 3) Take breaks every 25 minutes (Pomodoro technique). 4) Teach the material to someone else.',
        'summarize notes': 'Please paste your notes and I\'ll create a concise summary with key points highlighted.',
      };

      await new Promise(r => setTimeout(r, 800 + Math.random() * 600));
      typing.remove();

      const lowerText = text.toLowerCase();
      const response = responses[lowerText] || `I can help with that! For "${text}", let me suggest: start by reviewing your course materials related to this topic. Do you have specific questions about the content from your classrooms?`;
      addAIMessage(response, 'assistant');
    }

    // Close on Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && aiOpen) toggleAI();
    });

  script(src='https://cdn.jsdelivr.net/npm/chart.js')
  script.
    (function () {
      if (typeof Chart === 'undefined') return;
      var isDark = document.documentElement.classList.contains('dark');
      var rm = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var primary = isDark ? 'hsl(163,62%,55%)' : 'hsl(163,62%,41%)';
      var weekLabels = !{JSON.stringify(weekly && weekly.labels || [])};
      var weekData = !{JSON.stringify(weekly && weekly.data || [])};
      var monthLabels = !{JSON.stringify(monthly && monthly.labels || [])};
      var monthData = !{JSON.stringify(monthly && monthly.data || [])};
      var radarLabels = !{JSON.stringify(radar && radar.labels || [])};
      var radarData = !{JSON.stringify(radar && radar.data || [])};
      var heatmap = !{JSON.stringify(heatmap || [])};
      Chart.defaults.font.family = "'Geist','Satoshi',sans-serif";
      Chart.defaults.color = isDark ? '#94a3b8' : '#475569';

      function baseScales(extra) {
        return Object.assign({
          y: { beginAtZero: true, grid: { color: isDark ? 'rgba(255,255,255,0.05)' : 'rgba(0,0,0,0.05)' }, border: { display: false }, ticks: { precision: 0, padding: 8 } },
          x: { grid: { display: false }, border: { display: false }, ticks: { padding: 8 } }
        }, extra || {});
      }
      function tooltip() {
        return { backgroundColor: isDark ? 'rgba(9,9,11,0.92)' : 'rgba(255,255,255,0.95)', titleColor: isDark ? '#fff' : '#000', bodyColor: isDark ? '#a1a1aa' : '#52525b', borderColor: isDark ? '#27272a' : '#e4e4e7', borderWidth: 1, padding: 10, usePointStyle: true };
      }

      // Weekly bar
      var wc = document.getElementById('weeklyChart');
      if (wc && weekLabels.length) {
        new Chart(wc.getContext('2d'), {
          type: 'bar',
          data: { labels: weekLabels, datasets: [{ data: weekData, backgroundColor: primary, borderRadius: 6, barPercentage: 0.6, maxBarThickness: 28 }] },
          options: { responsive: true, maintainAspectRatio: false, animation: rm ? false : undefined, plugins: { legend: { display: false }, tooltip: tooltip() }, scales: baseScales({ y: { beginAtZero: true, precision: 0, grid: { color: isDark ? 'rgba(255,255,255,0.05)' : 'rgba(0,0,0,0.05)' }, ticks: { precision: 0, maxTicksLimit: 4 } } }) }
        });
      }
      // Monthly line
      var mc = document.getElementById('monthlyChart');
      if (mc && monthLabels.length) {
        new Chart(mc.getContext('2d'), {
          type: 'line',
          data: { labels: monthLabels, datasets: [{ data: monthData, borderColor: primary, backgroundColor: isDark ? 'hsla(163,62%,55%,0.15)' : 'hsla(163,62%,41%,0.1)', borderWidth: 3, tension: 0.4, fill: true, pointRadius: 0, pointHoverRadius: 6, pointHoverBackgroundColor: primary }] },
          options: { responsive: true, maintainAspectRatio: false, animation: rm ? false : undefined, plugins: { legend: { display: false }, tooltip: tooltip() }, scales: baseScales({ y: { max: 100, grid: { color: isDark ? 'rgba(255,255,255,0.05)' : 'rgba(0,0,0,0.05)' }, ticks: { maxTicksLimit: 4, callback: function(v){ return v + '%'; } } } }) }
        });
      }
      // Radar
      var rc = document.getElementById('radarChart');
      if (rc && radarLabels.length) {
        new Chart(rc.getContext('2d'), {
          type: 'radar',
          data: { labels: radarLabels, datasets: [{ data: radarData, borderColor: primary, backgroundColor: isDark ? 'hsla(163,62%,55%,0.2)' : 'hsla(163,62%,41%,0.15)', borderWidth: 2, pointBackgroundColor: primary, pointRadius: 3 }] },
          options: { responsive: true, maintainAspectRatio: false, animation: rm ? false : undefined, plugins: { legend: { display: false }, tooltip: tooltip() }, scales: { r: { min: 0, max: 100, grid: { color: isDark ? 'rgba(255,255,255,0.08)' : 'rgba(0,0,0,0.07)' }, angleLines: { color: isDark ? 'rgba(255,255,255,0.08)' : 'rgba(0,0,0,0.07)' }, pointLabels: { color: isDark ? '#a1a1aa' : '#52525b', font: { size: 10 } }, ticks: { display: false, stepSize: 25 } } } }
        });
      }
      // Heatmap (GitHub-style)
      var hm = document.getElementById('heatmap');
      if (hm && heatmap.length) {
        var max = 1;
        heatmap.forEach(function (c) { if (c.count > max) max = c.count; });
        var frag = document.createDocumentFragment();
        heatmap.forEach(function (c) {
          var cell = document.createElement('div');
          cell.className = 'heat-cell heat-l' + (c.count === 0 ? 0 : Math.min(4, Math.ceil((c.count / max) * 4)));
          cell.title = new Date(c.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) + ': ' + c.count + ' event' + (c.count === 1 ? '' : 's');
          frag.appendChild(cell);
        });
        hm.appendChild(frag);
      }
    })();