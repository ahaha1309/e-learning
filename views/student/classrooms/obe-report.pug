extends ../../layouts/base

block content
  .page-narrow.max-w-7xl.space-y-12.pt-8.pb-32
    //- Header Navigation
    header.flex.flex-col.gap-4.mb-8
      nav.text-xs.font-bold.text-muted-foreground.uppercase.tracking-widest.flex.items-center.gap-2(aria-label='Breadcrumbs')
        a.hover_text-primary.transition-colors(href='/student/classrooms') Lớp học
        span(class="text-muted-foreground/40") /
        a.hover_text-primary.transition-colors(href='/student/classrooms/' + classroom._id)= classroom.name
        span(class="text-muted-foreground/40") /
        span.text-foreground Chuẩn đầu ra OBE
      
      div.flex.flex-col.md_flex-row.md_items-center.justify-between.gap-6
        div
          h1.font-extrabold.tracking-tighter(style='font-size:clamp(2rem,5vw,2.5rem);line-height:1.1;')
            | Kết quả Chuẩn đầu ra (OBE)
          p.text-muted-foreground.mt-2(style='font-size:0.9375rem;') Phân tích và đánh giá năng lực học tập theo định hướng đầu ra.

        a.btn-outline.h-10.px-4.rounded-xl.inline-flex.items-center.gap-2(href='/student/classrooms/' + classroom._id)
          i.ph-bold.ph-arrow-left
          | Quay lại Lớp học

    //- Main Layout
    if clos.length === 0
      div(class="glass-panel p-12 text-center rounded-3xl border border-border/60")
        div(class="w-16 h-16 rounded-2xl bg-muted flex items-center justify-center mx-auto mb-6")
          i.ph-fill.ph-chart-bar.text-3xl.text-muted-foreground(class="opacity-40")
        h3.text-xl.font-extrabold.tracking-tight.mb-2 Chưa có dữ liệu chuẩn đầu ra
        p.text-muted-foreground.text-sm.max-w-md.mx-auto.mb-6 Giảng viên chưa thiết lập hoặc chưa chấm điểm các bài đánh giá đo lường chuẩn đầu ra (CLO) cho lớp học này.
    else
      .grid.grid-cols-1.lg_grid-cols-3.gap-8
        
        //- Left: Radar Chart visualization
        .lg_col-span-1.space-y-6
          div(class="glass-panel p-6 rounded-2xl border border-border/60 flex flex-col items-center")
            h3.text-base.font-extrabold.tracking-tight.mb-1 Biểu đồ Năng lực CLO
            p.text-xs.text-muted-foreground.mb-6 Trực quan hóa mức độ đạt được (%) theo từng chuẩn đầu ra
            
            div.relative.w-full.flex.justify-center(style='height: 260px;')
              canvas#radarChart(aria-label='Biểu đồ kỹ năng OBE', role='img')

          //- Gamification / Summary Card
          div(class="glass-panel p-6 rounded-2xl border border-border/60 bg-primary/5")
            .flex.items-center.gap-3.mb-4
              div(class="w-10 h-10 rounded-xl bg-primary/10 text-primary flex items-center justify-center")
                i.ph-fill.ph-award.text-xl
              div
                p.text-sm.font-extrabold.tracking-tight Trạng thái tổng quan
                p.text-xs.text-muted-foreground Tỷ lệ chuẩn môn học đã vượt qua
            
            - var passedClos = clos.filter(c => c.isPassed).length
            - var pctPassed = clos.length > 0 ? Math.round((passedClos / clos.length) * 100) : 0
            
            .flex.items-end.gap-2.mb-4
              p.text-4xl.font-mono.font-bold.tracking-tighter.text-primary #{pctPassed}%
              p.text-xs.text-muted-foreground(class="mb-1.5") Đạt (#{passedClos}/#{clos.length} CLOs)
            
            .w-full.bg-muted.rounded-full.overflow-hidden.h-2
              .bg-primary.h-full.rounded-full.transition-all(style='width: ' + pctPassed + '%')

        //- Right: List of CLOs and PLOs
        .lg_col-span-2.space-y-8
          //- CLO List
          div.space-y-4
            h2.text-lg.font-extrabold.tracking-tight Chuẩn đầu ra môn học (CLO)
            div(class="glass-panel overflow-hidden rounded-2xl border border-border/60 divide-y divide-border/60")
              each item in clos
                if item.outcome
                  div(class="p-5 flex items-start justify-between gap-4 transition-colors hover_bg-muted/10", id='clo-node-' + item.outcome._id)
                    div.flex-1.min-w-0
                      .flex.items-center.gap-2.mb-1
                        span(class="px-2 py-0.5 rounded-md bg-primary/10 text-primary font-bold text-xs")= item.outcome.code
                        span.text-xs.text-muted-foreground Yêu cầu tối thiểu: #{item.outcome.passThreshold || 50}%
                      p.text-sm.font-medium.text-foreground.leading-relaxed.markdown-content= item.outcome.description
                    
                    div.text-right.flex-shrink-0.flex.flex-col.items-end.gap-2
                      span.font-mono.font-bold.text-base(class=item.isPassed ? 'text-success' : 'text-destructive') #{item.achievedPercent}%
                      if item.isPassed
                        span(class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-bold bg-success/10 text-success")
                          i.ph-bold.ph-check-circle
                          | ĐẠT
                      else
                        span(class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-bold bg-destructive/10 text-destructive")
                          i.ph-bold.ph-warning-circle
                          | CHƯA ĐẠT



block scripts
  script(src='https://cdn.jsdelivr.net/npm/chart.js')
  script.
    document.addEventListener('DOMContentLoaded', () => {
      // 1. Compile KaTeX formula elements inside markdown-content
      if (window.renderMathInElement) {
        document.querySelectorAll('.markdown-content').forEach(el => {
          try {
            window.renderMathInElement(el, {
              delimiters: [
                {left: '$$', right: '$$', display: true},
                {left: '$', right: '$', display: false},
                {left: '\\(', right: '\\)', display: false},
                {left: '\\[', right: '\\]', display: true}
              ],
              throwOnError: false
            });
          } catch (e) {
            console.error('KaTeX rendering error:', e);
          }
        });
      }

      // 2. Render Radar Chart
      const isDark = document.documentElement.classList.contains('dark');
      const primaryColor = isDark ? 'hsl(163,62%,55%)' : 'hsl(163,62%,41%)';
      const bgColor = isDark ? 'hsla(163,62%,55%,0.2)' : 'hsla(163,62%,41%,0.15)';

      const closData = !{JSON.stringify(clos.filter(c => c.outcome).map(c => ({ code: c.outcome.code, pct: c.achievedPercent })))};
      const labels = closData.map(c => c.code);
      const dataValues = closData.map(c => c.pct);

      const canvas = document.getElementById('radarChart');
      if (canvas && labels.length) {
        new Chart(canvas.getContext('2d'), {
          type: 'radar',
          data: {
            labels: labels,
            datasets: [{
              label: 'Mức độ đạt được (%)',
              data: dataValues,
              borderColor: primaryColor,
              backgroundColor: bgColor,
              borderWidth: 2,
              pointBackgroundColor: primaryColor,
              pointRadius: 4
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              legend: { display: false }
            },
            scales: {
              r: {
                min: 0,
                max: 100,
                grid: {
                  color: isDark ? 'rgba(255,255,255,0.08)' : 'rgba(0,0,0,0.07)'
                },
                angleLines: {
                  color: isDark ? 'rgba(255,255,255,0.08)' : 'rgba(0,0,0,0.07)'
                },
                pointLabels: {
                  color: isDark ? '#a1a1aa' : '#52525b',
                  font: {
                    size: 11,
                    weight: 'bold'
                  }
                },
                ticks: { display: false, stepSize: 20 }
              }
            }
          }
        });
      }
    });
