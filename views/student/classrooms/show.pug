extends ../../layouts/base

block content
  .page-narrow.max-w-7xl.space-y-12.pt-8.pb-32
    //- Cinematic Header
    header.flex.flex-col.md_flex-row.md_items-end.justify-between.gap-8.animate-in.slide-in-up
      div
        nav.breadcrumb.animate-in.fade-in.mb-6
          a(href='/student/classrooms') Lớp học
          span.breadcrumb-sep /
          span.text-foreground.font-bold= membership.classroom.name
          
        .inline-flex.items-center.gap-2.rounded-full.border.text-primary.text-xs.font-bold.uppercase.tracking-widest.px-4.mb-6(class='py-1.5 bg-primary/5 border-primary/20') Đang tham gia
        h1.text-4xl.md_text-5xl.font-extrabold.tracking-tighter= membership.classroom.name
        p.text-xl.text-muted-foreground.mt-4.max-w-prose.leading-relaxed= membership.classroom.description || 'Chưa có mô tả.'
        
      .beam-border.deep-glass.p-5.flex.items-center.gap-6.min-w-64(class='rounded-[2rem] border-border/60')
        div.flex-1
          p.text-xs.font-bold.text-muted-foreground.uppercase.tracking-widest Trạng thái
          p.font-bold.text-2xl.capitalize.text-foreground= membership.status
        .w-14.h-14.rounded-2xl.flex.items-center.justify-center.border(class='bg-primary/10 text-primary border-primary/20')
          i.ph-bold.ph-key.text-2xl

    //- Central Meeting Status Banner for Students
    #meeting-banner-container(
      data-classroom-id=membership.classroom.id,
      data-is-teacher='false',
      data-csrf-token=csrfToken
    )
      if activeMeeting && activeMeeting.status === 'LIVE'
        .deep-glass.p-3.px-4.flex.flex-col.items-center.justify-between.gap-3.shadow-md.animate-in.slide-in-up(
          class='md_px-5 rounded-2xl border border-destructive/40 bg-destructive/5 sm_flex-row'
        )
          .flex.items-center.min-w-0(class='gap-3.5')
            .relative.flex.items-center.justify-center.w-10.h-10.rounded-xl.bg-destructive.text-white.shadow-md.flex-shrink-0
              i.ph-bold.ph-video-camera.text-lg
              span.absolute.flex.h-3.w-3(class='-top-0.5 -right-0.5')
                span.animate-ping.absolute.inline-flex.h-full.w-full.rounded-full.bg-destructive.opacity-75
                span.relative.inline-flex.rounded-full.h-3.w-3.bg-destructive.border-2.border-background
            .min-w-0
              .flex.items-center.gap-2.mb-1
                span.badge-destructive.px-2.font-black.uppercase.tracking-wider.flex.items-center.gap-1.shadow-sm(class='py-0.5 text-[10px]')
                  span.rounded-full.bg-white.animate-ping(class='w-1.5 h-1.5')
                  | LIVE
                span.text-xs.text-muted-foreground.truncate.font-medium • Giảng viên đang tổ chức
              h3.text-sm.font-extrabold.text-foreground.truncate= activeMeeting.title
          .flex.items-center.gap-2.w-full.flex-shrink-0.justify-end(class='sm_w-auto')
            a.btn-primary.btn-glow.h-9.px-5.rounded-xl.text-xs.font-extrabold.shadow.bg-destructive.text-white.flex.items-center.justify-center.transition-transform(
              class='gap-1.5 hover_bg-destructive/90 hover_scale-105',
              href='/classrooms/' + membership.classroom.id + '/meetings/' + activeMeeting.id + '/room'
            )
              i.ph-bold.ph-sign-in.text-sm
              | JOIN MEETING
      else if activeMeeting && activeMeeting.status === 'SCHEDULED'
        .deep-glass.p-3.px-4.flex.flex-col.items-center.justify-between.gap-3.shadow-sm.animate-in.slide-in-up(
          class='md_px-5 rounded-2xl border border-primary/30 bg-primary/5 sm_flex-row'
        )
          .flex.items-center.min-w-0(class='gap-3.5')
            .w-10.h-10.rounded-xl.text-primary.flex.items-center.justify-center.flex-shrink-0(class='bg-primary/10 border border-primary/20')
              i.ph-bold.ph-calendar-blank.text-xl
            .min-w-0
              .flex.items-center.gap-2.mb-1
                span.badge-primary.px-2.font-bold.uppercase.tracking-wider(class='py-0.5 text-[10px]')
                  | 📅 UPCOMING MEETING
              h3.text-sm.font-extrabold.text-foreground.truncate= activeMeeting.title
              p#meeting-countdown.text-xs.font-semibold.text-primary.flex.items-center.gap-1(
                data-start-time=activeMeeting.startTime.toISOString()
              )
                | ⏱️ Đang tính thời gian...
          .flex.items-center.gap-2.w-full.flex-shrink-0.justify-end(class='sm_w-auto')
            a.btn-outline.h-9.px-4.rounded-xl.text-xs.font-bold.opacity-75.pointer-events-none.border-border(href='#')
              | Chờ bắt đầu

    //- Navigation Bento Grid
    .grid.grid-cols-2.md_grid-cols-3.lg_grid-cols-6.gap-6.animate-in.slide-in-up(style='animation-delay: 150ms;')
      a.spotlight-card.glass-panel.p-6.text-center.transition-all.group(href='/student/classrooms/' + membership.classroom.id + '/lectures', class='hover_border-primary/50 hover_bg-primary/5 rounded-[1.5rem]')
        .w-14.h-14.rounded-2xl.text-primary.flex.items-center.justify-center.mx-auto.mb-4.transition-transform.group-hover_scale-110(class='bg-primary/10 border border-primary/20')
          i.ph-fill.ph-monitor-play.text-2xl
        p.text-sm.font-bold.tracking-tight Bài giảng
      
      a.spotlight-card.glass-panel.p-6.text-center.transition-all.group(href='/student/classrooms/' + membership.classroom.id + '/assignments', class='hover_border-warning/50 hover_bg-warning/5 rounded-[1.5rem]')
        .w-14.h-14.rounded-2xl.text-warning.flex.items-center.justify-center.mx-auto.mb-4.transition-transform.group-hover_scale-110(class='bg-warning/10 border border-warning/20')
          i.ph-fill.ph-file-code.text-2xl
        p.text-sm.font-bold.tracking-tight Bài tập
      
      a.spotlight-card.glass-panel.p-6.text-center.transition-all.group(href='/student/classrooms/' + membership.classroom.id + '/exams', class='hover_border-destructive/50 hover_bg-destructive/5 rounded-[1.5rem]')
        .w-14.h-14.rounded-2xl.text-destructive.flex.items-center.justify-center.mx-auto.mb-4.transition-transform.group-hover_scale-110(class='bg-destructive/10 border border-destructive/20')
          i.ph-fill.ph-exam.text-2xl
        p.text-sm.font-bold.tracking-tight Bài thi
      
      a.spotlight-card.glass-panel.p-6.text-center.transition-all.group(href='/student/classrooms/' + membership.classroom.id + '/discussions', class='hover_border-success/50 hover_bg-success/5 rounded-[1.5rem]')
        .w-14.h-14.rounded-2xl.text-success.flex.items-center.justify-center.mx-auto.mb-4.transition-transform.group-hover_scale-110(class='bg-success/10 border border-success/20')
          i.ph-fill.ph-chats.text-2xl
        p.text-sm.font-bold.tracking-tight Thảo luận
      
      a.spotlight-card.glass-panel.p-6.text-center.transition-all.group(href='/student/classrooms/' + membership.classroom.id + '/attendance', class='hover_border-info/50 hover_bg-info/5 rounded-[1.5rem]')
        .w-14.h-14.rounded-2xl.text-info.flex.items-center.justify-center.mx-auto.mb-4.transition-transform.group-hover_scale-110(class='bg-info/10 border border-info/20')
          i.ph-fill.ph-check-square.text-2xl
        p.text-sm.font-bold.tracking-tight Điểm danh

      a.spotlight-card.glass-panel.p-6.text-center.transition-all.group(href='/student/classrooms/' + membership.classroom.id + '/obe-report', class='hover_border-primary/50 hover_bg-primary/5 rounded-[1.5rem]')
        .w-14.h-14.rounded-2xl.text-primary.flex.items-center.justify-center.mx-auto.mb-4.transition-transform.group-hover_scale-110(class='bg-primary/10 border border-primary/20')
          i.ph-fill.ph-target.text-2xl
        p.text-sm.font-bold.tracking-tight Chuẩn OBE

    //- Dynamic Syllabus Progress
    //- Everything below is rendered from `courseProgress` returned by the backend
    //- (services/courseProgress.service.js). The view computes nothing — no hardcoded
    //- weeks, statuses, or counts. Add/remove content in the DB and the UI adapts.
    section.mt-16.animate-in.slide-in-up(style='animation-delay: 300ms;')
      h2.text-2xl.font-extrabold.tracking-tight.mb-8 Tiến độ Giáo trình

      if courseProgress
        //- Course-level progress (also backend-computed, never stored)
        .deep-glass.p-6.mb-6(class='rounded-[2rem] border-border/60')
          .flex.items-center.justify-between.gap-4.mb-3
            p.text-sm.font-bold.text-foreground Tiến độ khóa học
            p.text-sm.font-mono.text-muted-foreground
              | #{courseProgress.completedItems}/#{courseProgress.totalItems} mục
              if courseProgress.remainingItems > 0
                |  — còn lại #{courseProgress.remainingItems}
          .h-2.rounded-full.bg-muted.overflow-hidden
            .h-full.rounded-full.bg-primary.transition-all(style='width: ' + courseProgress.progressPercent + '%')

        //- Course completion verdict (Phase C). Only shown when the teacher set
        //- explicit rules; otherwise completion is implicit (no minimums).
        if courseCompletion && courseCompletion.missing && courseCompletion.missing.length
          .deep-glass.p-6.mb-6(class='rounded-[2rem] border-border/60')
            .flex.items-start.gap-4
              .w-10.h-10.rounded-xl.flex.items-center.justify-center.flex-shrink-0(class='bg-warning/10 text-warning border border-warning/20')
                i.ph-bold.ph-warning-circle.text-xl
              div
                p.text-base.font-bold.text-foreground Khóa học chưa hoàn thành
                p.text-sm.text-muted-foreground.mt-1
                  | Yêu cầu còn lại:
                  each req in courseCompletion.missing
                    span.badge-muted.ml-2.text-xs= req
        else if courseCompletion && courseCompletion.isComplete
          .deep-glass.p-6.mb-6(class='rounded-[2rem] border-border/60')
            .flex.items-center.gap-4
              .w-10.h-10.rounded-xl.flex.items-center.justify-center.flex-shrink-0(class='bg-success/10 text-success border border-success/20')
                i.ph-bold.ph-check-circle.text-xl
              div
                p.text-base.font-bold.text-foreground Khóa học hoàn tất
                p.text-sm.text-muted-foreground.mt-1 Bạn đã hoàn thành tất cả các mục tiêu của khóa học.

        .deep-glass.p-8.sm_p-12.w-full(class='rounded-[2.5rem] border-border/60')
          if courseProgress.modules && courseProgress.modules.length
            .grid.grid-cols-1.gap-10.w-full
              each module, moduleIndex in courseProgress.modules
                .flex.gap-8.relative.w-full
                if moduleIndex < courseProgress.modules.length - 1
                  .absolute.top-14.left-6.w-px.-z-10(class=(module.status === courseProgress.status.COMPLETED ? 'bg-primary/50' : 'bg-border/60') + ' bottom-[-40px]')
                //- Module node icon driven by backend-computed status
                if module.status === courseProgress.status.COMPLETED
                  .w-12.h-12.rounded-full.text-primary-foreground.flex.items-center.justify-center.flex-shrink-0.shadow-md.border(class='bg-primary border-primary/20')
                    i.ph-bold.ph-check.text-xl
                else if module.status === courseProgress.status.IN_PROGRESS
                  .w-12.h-12.rounded-full.bg-background.border-2.border-primary.text-primary.flex.items-center.justify-center.flex-shrink-0.animate-pulse
                    span.w-3.h-3.rounded-full.bg-primary
                else if module.status === courseProgress.status.LOCKED
                  .w-12.h-12.rounded-full.text-muted-foreground.flex.items-center.justify-center.flex-shrink-0.border.border-border(class='bg-muted/50')
                    i.ph-bold.ph-lock.text-xl
                else
                  .w-12.h-12.rounded-full.text-muted-foreground.flex.items-center.justify-center.flex-shrink-0.border.border-border(class='bg-muted/50')
                    i.ph-bold.ph-circle-dashed.text-xl

                div.flex-1.pt-2
                  h4.text-xl.font-bold(class=(module.status === courseProgress.status.LOCKED ? 'text-muted-foreground' : 'text-foreground'))= module.key
                  p.text-xs.font-bold.mt-1.uppercase.tracking-widest(class=(module.status === courseProgress.status.COMPLETED ? 'text-primary' : 'text-muted-foreground'))
                    span
                      if module.status === courseProgress.status.COMPLETED
                        | Đã hoàn thành
                      else if module.status === courseProgress.status.IN_PROGRESS
                        | Đang tiến hành
                      else if module.status === courseProgress.status.LOCKED
                        | Đã khóa
                      else
                        | #{module.status}
                    if module.status === courseProgress.status.IN_PROGRESS && module.remainingItems > 0
                      |  — còn lại #{module.remainingItems} mục

                  //- Module progress bar — width is the backend-computed percentage
                  if module.totalItems > 0
                    .flex.items-center.gap-3.mt-3
                      .rounded-full.bg-muted.overflow-hidden.flex-1(style='height: 6px')
                        .rounded-full.bg-primary/70.transition-all(style='height: 6px; width: ' + module.progressPercent + '%')
                      span.text-xs.font-mono.text-muted-foreground #{module.completedItems}/#{module.totalItems}

                  //- Inner items — rendered from module.children, status-driven
                  if module.children && module.children.length
                    .grid.grid-cols-1.gap-3.mt-5
                      each item in module.children
                        if item.status === courseProgress.status.LOCKED
                          .border.p-4.flex.items-center.justify-between(class='border-border/60 rounded-[1rem]')
                            .flex.items-center.gap-4
                              i.ph-fill.ph-lock.text-2xl(class='text-muted-foreground/50')
                              span.font-medium.text-base.text-muted-foreground= item.title
                            span.text-xs.font-bold.uppercase.tracking-widest.text-muted-foreground Đã khóa
                        else if item.status === courseProgress.status.COMPLETED
                          a.border.p-4.flex.items-center.justify-between.transition-colors(href=item.href, class='border-primary/40 rounded-[1rem] hover_border-primary/50 hover_bg-primary/5')
                            .flex.items-center.gap-4
                              i.ph-fill.ph-check-circle.text-2xl.text-primary
                              span.font-bold.text-base= item.title
                            span.text-xs.font-bold.uppercase.tracking-widest.text-primary Đã hoàn thành
                        else if item.status === courseProgress.status.IN_PROGRESS
                          a.border.p-4.flex.items-center.justify-between.cursor-pointer.transition-colors(href=item.href, class='border-primary/60 rounded-[1rem] hover_border-primary/50 hover_bg-primary/5')
                            .flex.items-center.gap-4
                              i.ph-fill.ph-play-circle.text-2xl.text-primary
                              span.font-bold.text-base= item.title
                            span.text-xs.font-bold.uppercase.tracking-widest.text-primary Đang tiến hành
                        else
                          a.border.p-4.flex.items-center.justify-between.cursor-pointer.transition-colors(href=item.href, class='border-border/60 rounded-[1rem] hover_border-primary/50 hover_bg-primary/5')
                            .flex.items-center.gap-4
                              i.ph-fill.ph-circle.text-2xl.text-muted-foreground
                              span.font-medium.text-base= item.title
                            span.text-xs.font-bold.uppercase.tracking-widest.text-muted-foreground Bắt đầu
          else
            .empty-state.text-center.py-8
              p.text-sm.text-muted-foreground Chưa có nội dung được xuất bản. Giảng viên của bạn sẽ thêm bài học, bài tập và bài thi ở đây.
      else
        .empty-state.text-center.py-8
          p.text-sm.text-muted-foreground Tiến độ khóa học hiện không khả dụng.

    //- Floating AI Assistant Button & Chatbox
    #ai-assistant-container.fixed.bottom-6.right-6.z-50
      //- Button
      button#ai-assistant-btn.flex.items-center.justify-center.w-14.h-14.rounded-full.bg-primary.text-primary-foreground.shadow-lg.hover_scale-110.transition-all.cursor-pointer.border-none(
        aria-label='Chat with AI Tutor',
        title='Hỏi Trợ lý AI'
      )
        i.ph-bold.ph-cpu.text-2xl
      
      //- Chat Box (initially hidden)
      #ai-chatbox.hidden.absolute.bottom-18.right-0.w-96.glass-panel.rounded-2xl.shadow-2xl.flex.flex-col.overflow-hidden.border.border-border.transition-all.bg-background(style='height: 480px;')
        //- Header
        div(class="p-4 bg-primary/5 border-b border-border flex items-center justify-between")
          .flex.items-center.gap-2.text-primary
            i.ph-bold.ph-cpu.text-xl
            div
              h3.text-sm.font-bold.text-foreground Trợ lý Học tập AI
              p.text-xs.text-muted-foreground.font-medium Trực tuyến
          button#close-chat-btn.text-muted-foreground.hover_text-foreground.transition-colors.cursor-pointer.bg-transparent.border-none
            i.ph-bold.ph-x.text-lg
            
        //- Messages Area
        #ai-messages.flex-1.p-4.overflow-y-auto.space-y-4.text-sm
          div(class="ai-message bg-muted p-3 rounded-2xl rounded-tl-none max-w-[85%] space-y-2")
            p Xin chào! Tôi là trợ lý học tập AI của lớp học **#{membership.classroom.name}**.
            p Bạn có thắc mắc gì về các bài giảng, bài tập hoặc tiến trình học tập của môn học này không?
            
        //- Input Box
        form#ai-chat-form.p-4.border-t.border-border.flex.gap-2.m-0
          input#ai-input.flex-1.bg-muted.border.border-border.rounded-xl.px-4.py-2.text-sm.focus_outline-none.focus_border-primary(
            type='text',
            placeholder='Hỏi gì đó về môn học...',
            required=true,
            autocomplete='off'
          )
          button.btn-primary.btn-glow.px-4.rounded-xl.flex.items-center.justify-center.border-none(type='submit')
            i.ph-bold.ph-paper-plane-tilt.text-base

  script.
    document.addEventListener('DOMContentLoaded', () => {
      const btn = document.getElementById('ai-assistant-btn');
      const chatbox = document.getElementById('ai-chatbox');
      const closeBtn = document.getElementById('close-chat-btn');
      const form = document.getElementById('ai-chat-form');
      const input = document.getElementById('ai-input');
      const messagesContainer = document.getElementById('ai-messages');

      // Toggle Chatbox
      btn.addEventListener('click', () => {
        chatbox.classList.toggle('hidden');
        if (!chatbox.classList.contains('hidden')) {
          input.focus();
          if (window.renderMathInElement) {
            try {
              window.renderMathInElement(messagesContainer, {
                delimiters: [
                  {left: '$$', right: '$$', display: true},
                  {left: '$', right: '$', display: false},
                  {left: '\\(', right: '\\)', display: false},
                  {left: '\\[', right: '\\]', display: true}
                ],
                throwOnError: false
              });
            } catch (e) {}
          }
        }
      });

      closeBtn.addEventListener('click', () => {
        chatbox.classList.add('hidden');
      });

      // Handle Submit
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const text = input.value.trim();
        if (!text) return;

        // Add user message
        const userMsgEl = document.createElement('div');
        userMsgEl.className = 'user-message bg-primary text-primary-foreground p-3 rounded-2xl rounded-tr-none max-w-[85%] ml-auto text-right';
        userMsgEl.textContent = text;
        messagesContainer.appendChild(userMsgEl);
        input.value = '';
        messagesContainer.scrollTop = messagesContainer.scrollHeight;

        // Add typing indicator
        const typingEl = document.createElement('div');
        typingEl.className = 'ai-message bg-muted p-3 rounded-2xl rounded-tl-none max-w-[85%] text-muted-foreground flex items-center gap-1';
        typingEl.innerHTML = '<span class="animate-bounce">●</span><span class="animate-bounce" style="animation-delay: 0.1s">●</span><span class="animate-bounce" style="animation-delay: 0.2s">●</span>';
        messagesContainer.appendChild(typingEl);
        messagesContainer.scrollTop = messagesContainer.scrollHeight;

        try {
          const res = await fetch(window.location.pathname + '/ai-assistant', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'CSRF-Token': '#{csrfToken}'
            },
            body: JSON.stringify({ message: text })
          });
          const data = await res.json();
          typingEl.remove();

          const aiMsgEl = document.createElement('div');
          aiMsgEl.className = 'ai-message bg-muted p-3 rounded-2xl rounded-tl-none max-w-[85%] text-foreground space-y-1';
          
          if (data.answer) {
            // Render markdown lists and bold text cleanly (basic converter)
            let formattedAnswer = data.answer
              .replace(/\n/g, '<br>')
              .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
              .replace(/\*(.*?)\*/g, '<em>$1</em>')
              .replace(/^- (.*?)$/gm, '• $1')
              .replace(/<br><br>/g, '<br>');
            aiMsgEl.innerHTML = formattedAnswer;
            if (window.renderMathInElement) {
              try {
                window.renderMathInElement(aiMsgEl, {
                  delimiters: [
                    {left: '$$', right: '$$', display: true},
                    {left: '$', right: '$', display: false},
                    {left: '\\(', right: '\\)', display: false},
                    {left: '\\[', right: '\\]', display: true}
                  ],
                  throwOnError: false
                });
              } catch (e) {}
            }
          } else {
            aiMsgEl.textContent = data.error || 'Có lỗi xảy ra.';
          }
          
          messagesContainer.appendChild(aiMsgEl);
        } catch (err) {
          typingEl.remove();
          const errEl = document.createElement('div');
          errEl.className = 'ai-message bg-destructive/10 text-destructive p-3 rounded-2xl rounded-tl-none max-w-[85%]';
          errEl.textContent = 'Lỗi kết nối máy chủ.';
          messagesContainer.appendChild(errEl);
        }
        messagesContainer.scrollTop = messagesContainer.scrollHeight;
      });
    });

  script(src='/socket.io/socket.io.js')
  script(src='/js/classroom-meeting-banner.js')