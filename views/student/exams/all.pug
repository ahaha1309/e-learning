extends ../../layouts/base

include ../../layouts/mixins

block content
  .page.space-y-8.pt-8
    +pgHeader({ eyebrow: 'Học sinh', icon: 'ph-bold ph-exam', h1: 'Tất cả bài thi', subtitle: 'Mọi bài thi trên các lớp học của bạn. Tiếp tục bài đang làm hoặc bắt đầu một bài thi mới từ đây.' })
      .glass-panel.rounded-2xl.p-4.flex.items-center.gap-4(class='border-border/60')
        .w-10.h-10.rounded-xl.flex.items-center.justify-center.text-warning(class='bg-warning/10')
          i.ph-bold.ph-exam.text-lg
        div
          p.text-xs.font-bold.text-muted-foreground.uppercase.tracking-widest Bài thi
          p.font-mono.text-2xl.font-bold.tracking-tighter= groups.reduce((n, g) => n + g.items.length, 0)

    if groups && groups.length
      .space-y-10.animate-in.slide-in-up(style='animation-delay:100ms;')
        each group in groups
          section.space-y-4
            .flex.items-center.gap-2
              i.ph-bold.ph-chalkboard.text-base.text-muted-foreground
              h2.text-lg.font-extrabold.tracking-tight= group.classroom.name
              if group.classroom.code
                span.text-xs.font-mono.text-muted-foreground · #{group.classroom.code}
            .space-y-4
              each exam in group.items
                article.card.p-5.transition-colors(class='hover_border-primary/50')
                  .flex.flex-col.md_flex-row.md_items-start.justify-between.gap-4
                    .flex-1
                      h3.text-lg.font-bold= exam.title
                      .flex.flex-wrap.items-center.gap-3.mt-3
                        if exam.duration
                          span.badge.badge-muted.badge-sm= exam.duration + ' phút'
                        if exam.totalPoints
                          span.badge.badge-warning.badge-sm= exam.totalPoints + ' điểm'
                        if exam.maxAttempts
                          span.text-xs.text-muted-foreground Lần dùng #{exam.usedAttempts}/#{exam.maxAttempts}
                        if exam.hasInProgress
                          span.badge.badge-info.badge-sm Đang làm
                  .flex.flex-wrap.gap-2.mt-4.pt-4.border-t.border-border
                    if exam.canStart || exam.hasInProgress
                      a.btn-primary.btn-sm(href=`/student/classrooms/${group.classroom._id}/exams/${exam._id}/take`)
                        i.ph-bold.ph-play
                        | #{exam.hasInProgress ? 'Tiếp tục' : 'Làm bài'}
                    a.btn-outline.btn-sm(href=`/student/classrooms/${group.classroom._id}/exams/${exam._id}/result`) Xem kết quả
    else
      +emptyState({ icon: 'ph-fill ph-exam', title: 'Chưa có bài thi nào', desc: 'Khi giảng viên xuất bản bài thi trên lớp học bạn đã tham gia, chúng sẽ xuất hiện tại đây. Hãy tham gia một lớp học để bắt đầu.', ctaText: 'Tìm lớp học', ctaHref: '/catalog' })
