//- ── EXAM ENGINE: Focus Mode UI ─────────────────────────────────────────
//- vars: exam, submission, questions, classroom, currentUser, csrfToken
//- Anti-cheat: anti-cheat-config JSON embedded for anti-cheat.js

extends ../../layouts/base

block head
  //- Lock the entire page layout for focus mode
  style.
    body {
      overflow: hidden;
    }
    /* Exam shell covers the whole viewport (above the app topbar/sidebar) so the
       100dvh grid isn't pushed down and clipped at the bottom */
    .exam-shell {
      position: fixed;
      inset: 0;
      z-index: 300;
    }
    /* Prevent right-click context menu visual feedback */
    * { -webkit-user-select: none; user-select: none; }
    textarea, input[type="text"] { -webkit-user-select: text; user-select: text; }
    /* Fix CodeMirror layout with Tailwind CSS */
    .CodeMirror, .CodeMirror * { box-sizing: content-box !important; }

block content
  //- Anti-cheat config consumed by /js/anti-cheat.js
  script#anti-cheat-config(type='application/json').
    !{JSON.stringify({ examId: exam.id, studentId: currentUser.id, studentName: currentUser.name, strictMode: exam.strictMode, maxViolations: exam.maxViolations })}

  //- ── PRE-EXAM FULLSCREEN GATE (replaces raw JS overlay with styled Pug) ──
  #exam-gate.exam-blur-overlay(
    role='alertdialog',
    aria-modal='true',
    aria-labelledby='exam-gate-title',
    aria-describedby='exam-gate-desc'
  )
    .exam-violation-card(style='border-color: hsl(var(--primary)/0.3);')
      .w-14.h-14.rounded-2xl.flex.items-center.justify-center.mx-auto.mb-6(class='bg-primary/10')
        i.ph-bold.ph-exam.text-2xl.text-primary(aria-hidden='true')
      h2.text-xl.font-extrabold.tracking-tight.mb-2(id='exam-gate-title')= exam.title
      p.text-sm.text-muted-foreground.mb-1.leading-relaxed(id='exam-gate-desc')
        | Đây là bài thi có tính giờ và được giám sát. Khi bạn bắt đầu, bộ đếm thời gian sẽ chạy và không thể tạm dừng.
      if exam.strictMode
        .mt-4.p-4.rounded-xl.text-left.space-y-2.mb-6(class='bg-destructive/5 border border-destructive/15')
          p.text-xs.font-bold.uppercase.tracking-widest.text-destructive.mb-3 Chế độ Nghiêm ngặt Đang bật
          .flex.items-start.gap-2.text-xs.text-muted-foreground
            i.ph-bold.ph-prohibit.text-destructive.text-sm.flex-shrink-0(class='mt-0.5', aria-hidden='true')
            | Không chuyển đổi tab hoặc cửa sổ
          .flex.items-start.gap-2.text-xs.text-muted-foreground
            i.ph-bold.ph-prohibit.text-destructive.text-sm.flex-shrink-0(class='mt-0.5', aria-hidden='true')
            | Không thoát chế độ toàn màn hình
          .flex.items-start.gap-2.text-xs.text-muted-foreground
            i.ph-bold.ph-prohibit.text-destructive.text-sm.flex-shrink-0(class='mt-0.5', aria-hidden='true')
            | Không sao chép, dán hoặc nhấp chuột phải
          if exam.maxViolations > 0
            .flex.items-start.gap-2.text-xs.text-muted-foreground
              i.ph-bold.ph-warning.text-warning.text-sm.flex-shrink-0(class='mt-0.5', aria-hidden='true')
              | Tự động nộp bài sau #{exam.maxViolations} vi phạm
      else
        .mb-6
      //- Duration display
      if exam.duration > 0
        .flex.items-center.justify-center.gap-2.text-sm.font-bold.text-muted-foreground.mb-6
          i.ph-bold.ph-clock.text-primary(aria-hidden='true')
          span Thời lượng: #{exam.duration} phút

      button#start-exam-btn.btn-primary.w-full.h-12.rounded-xl.font-bold.text-base(type='button')
        if exam.strictMode
          i.ph-bold.ph-arrows-out.text-lg(aria-hidden='true')
          | Vào Toàn màn hình & Bắt đầu
        else
          i.ph-bold.ph-play.text-lg(aria-hidden='true')
          | Bắt đầu Bài thi

  //- ── VIOLATION OVERLAY (non-panic, informational) ─────────────────────
  #violation-overlay.exam-blur-overlay(
    role='alertdialog',
    aria-modal='true',
    aria-labelledby='violation-title',
    aria-describedby='violation-desc'
  )
    .exam-violation-card
      .w-12.h-12.rounded-2xl.flex.items-center.justify-center.mx-auto.mb-5(class='bg-destructive/10')
        i.ph-bold.ph-warning-circle.text-2xl.text-destructive(aria-hidden='true')
      h3.text-lg.font-extrabold.tracking-tight.mb-1(id='violation-title') Cảnh báo Toàn vẹn
      p.text-sm.text-muted-foreground.leading-relaxed.mb-4(id='violation-desc')
        | Phát hiện một vấn đề toàn vẹn tiềm ẩn. Vui lòng quay lại bài thi.
      p.text-xs.font-bold.text-muted-foreground.mb-5(id='violation-count-text') Đã ghi nhận vi phạm.
      button#dismiss-violation.btn-primary.w-full.h-11.rounded-xl.font-bold(type='button')
        i.ph-bold.ph-arrow-u-up-left(aria-hidden='true')
        | Quay lại Bài thi

  //- ── EXAM SHELL ──────────────────────────────────────────────────────────
  .exam-shell#exam-shell

    //- Sticky topbar (always visible)
    header.exam-topbar(role='banner', aria-label='Exam controls')
      //- Left: title + live badge
      .flex.items-center.min-w-0(class='gap-3')
        .inline-flex.items-center.gap-2.rounded-full.px-3.text-xs.font-bold.uppercase.tracking-widest.text-destructive.flex-shrink-0(class='bg-destructive/10 py-1.5')
          span.w-2.h-2.rounded-full.bg-destructive.animate-pulse(aria-hidden='true')
          | Trực tiếp
        h1.text-base.font-bold.tracking-tight.truncate= exam.title

      //- Center: countdown timer + submit button
      .flex.items-center(class='gap-4')
        if exam.duration > 0
          .flex.items-center(class='gap-2')
            i.ph-bold.ph-timer.text-muted-foreground(aria-hidden='true')
            time#timer.exam-timer(
              datetime='',
              data-duration=exam.duration,
              data-started=submission.startedAt.toISOString(),
              aria-label='Thời gian còn lại'
            ) --:--
        else
          .text-sm.text-muted-foreground Thời gian không giới hạn
        //- Button lives outside the form, linked via the form attribute
        button.btn-primary.h-10.px-5.rounded-full.font-bold.flex-shrink-0.active_scale-95.transition-transform(
          type='submit',
          form='exam-form',
          id='submit-exam-btn'
        )
          i.ph-bold.ph-paper-plane-tilt(aria-hidden='true')
          | Nộp bài thi

      //- Right: integrity status
      .flex.items-center(class='gap-2')
        .exam-integrity-dot#integrity-dot(aria-hidden='true')
        span#integrity-label.text-xs.font-bold.text-muted-foreground Đang giám sát

    //- Question area (scrollable)
    main.overflow-y-auto(aria-label='Exam questions')
      form#exam-form.max-w-3xl.mx-auto.px-4.py-10.space-y-8(
        method='POST',
        action='/student/classrooms/' + classroom.id + '/exams/' + exam.id + '/submit'
      )
        input(type='hidden', name='_csrf', value=csrfToken)
        input(type='hidden', name='submissionId', value=submission.id)
        input(type='hidden', id='violationsJson', name='violationsJson', value='[]')

        if questions && questions.length
          - var pointPerQuestion = questions.length > 0 ? (exam.totalPoints / questions.length) : 0;
          each question, index in questions
            article.glass-panel.relative.overflow-hidden.animate-in.slide-in-up(
              class='rounded-2xl border-border/60 p-8',
              style='animation-delay: ' + (index * 60) + 'ms',
              aria-labelledby='q-label-' + index
            )
              //- Left accent bar
              .absolute.top-0.left-0.w-1.h-full.bg-primary(aria-hidden='true')

              .flex.items-start.justify-between.mb-6(class='gap-4')
                .flex.items-center(class='gap-3')
                  span.flex-shrink-0.w-9.h-9.rounded-xl.flex.items-center.justify-center.text-sm.font-bold.text-primary(
                    class='bg-primary/10 border border-primary/20',
                    id='q-label-' + index,
                    aria-label='Câu hỏi ' + (index + 1)
                  )= index + 1
                  if question.type === 'multiple_choice'
                    span.text-xs.font-bold.uppercase.tracking-widest.text-muted-foreground Trắc nghiệm
                  else if question.type === 'multiple_answer'
                    span.text-xs.font-bold.uppercase.tracking-widest.text-muted-foreground Chọn tất cả đáp án đúng
                  else
                    span.text-xs.font-bold.uppercase.tracking-widest.text-muted-foreground Tự luận

                span.badge.badge-muted.flex-shrink-0(aria-label=pointPerQuestion.toFixed(2) + ' điểm')
                  i.ph-bold.ph-star.text-xs(aria-hidden='true')
                  | #{pointPerQuestion.toFixed(2)} điểm

              //- Question content
              .text-base.font-medium.leading-relaxed.mb-6 !{question.content ? question.content.replace(/&lt;/g, '<').replace(/&gt;/g, '>') : ''}

              //- Answer inputs
              if question.type === 'multiple_choice'
                fieldset.grid.gap-3(aria-label='Answer options for question ' + (index + 1))
                  legend.sr-only= 'Choose one answer for question ' + (index + 1)
                  each opt in question.options
                    label.group.flex.items-center.gap-4.p-4.rounded-xl.border.cursor-pointer.transition-all.duration-150(
                      class='border-border/60 hover_border-primary hover_bg-primary/5'
                    )
                      .relative.flex-shrink-0
                        input.peer.sr-only(
                          type='radio',
                          name='q_' + question.id,
                          value=opt.id,
                          required
                        )
                        .w-5.h-5.rounded-full.border-2.transition-all(class='border-muted-foreground peer-checked_border-primary peer-checked_bg-primary')
                        i.ph-bold.ph-check.absolute.inset-0.flex.items-center.justify-center.text-white.text-xs.opacity-0.scale-50.transition-all(class='peer-checked_opacity-100 peer-checked_scale-100', aria-hidden='true')
                      span.text-sm.text-foreground.font-medium.transition-colors(class='group-hover_text-primary')= opt.text

              else if question.type === 'multiple_answer'
                fieldset.grid.gap-3(aria-label='Answer options for question ' + (index + 1))
                  legend.sr-only= 'Select all correct answers for question ' + (index + 1)
                  each opt in question.options
                    label.group.flex.items-center.gap-4.p-4.rounded-xl.border.cursor-pointer.transition-all.duration-150(
                      class='border-border/60 hover_border-primary hover_bg-primary/5'
                    )
                      .relative.flex-shrink-0
                        input.peer.sr-only(
                          type='checkbox',
                          name='q_' + question.id,
                          value=opt.id
                        )
                        .w-5.h-5.rounded-md.border-2.transition-all(class='border-muted-foreground peer-checked_border-primary peer-checked_bg-primary')
                        i.ph-bold.ph-check.absolute.inset-0.flex.items-center.justify-center.text-white.text-xs.opacity-0.scale-50.transition-all(class='peer-checked_opacity-100 peer-checked_scale-100', aria-hidden='true')
                      span.text-sm.text-foreground.font-medium.transition-colors(class='group-hover_text-primary')= opt.text

              else if question.type === 'essay'
                label.sr-only(for='essay-' + question.id) Essay answer for question #{index + 1}
                textarea.w-full.p-4.rounded-xl.border.bg-background.text-foreground.text-sm.resize-y.transition-all(
                  class=`border-border/60 min-h-[140px] focus_outline-none focus_ring-2 focus_ring-primary focus_border-transparent ${question.isCoding ? 'code-editor' : ''}`,
                  name='q_' + question.id,
                  id='essay-' + question.id,
                  placeholder='Viết câu trả lời của bạn ở đây...',
                  style='-webkit-user-select: text; user-select: text;'
                )

        else
          .empty-state.mx-4
            i.ph-bold.ph-question.text-4xl.text-muted-foreground.mb-3(aria-hidden='true')
            h3.text-lg.font-bold Chưa có câu hỏi nào được tải
            p.text-sm.text-muted-foreground Vui lòng liên hệ với giảng viên của bạn.


    //- Progress strip at bottom (question nav dots)
    footer.exam-topbar(style='padding: 0.5rem 1.5rem; border-top: 1px solid hsl(var(--border)); border-bottom: none;', aria-label='Question progress')
      .flex.items-center.gap-1.flex-wrap
        each question, index in (questions || [])
          a.w-7.h-7.rounded-lg.flex.items-center.justify-center.text-xs.font-bold.transition-colors.border(
            href='#q-label-' + index,
            class='bg-muted border-border text-muted-foreground hover_border-primary hover_text-primary hover_bg-primary/5',
            aria-label='Jump to question ' + (index + 1)
          )= index + 1
      .ml-auto.text-xs.font-bold.text-muted-foreground= (questions ? questions.length : 0) + ' câu hỏi'

  //- ── TIMER SCRIPT ────────────────────────────────────────────────────────
  script.
    (function () {
      var timerEl = document.getElementById('timer');
      if (timerEl) {
        var durationMins = parseInt(timerEl.dataset.duration, 10);
        var startedAt    = new Date(timerEl.dataset.started).getTime();
        var endTime      = startedAt + durationMins * 60 * 1000;

        var interval = setInterval(function () {
          var now      = Date.now();
          var distance = endTime - now;

          if (distance <= 0) {
            clearInterval(interval);
            timerEl.textContent = '00:00';
            timerEl.classList.add('urgent');
            document.getElementById('exam-form').submit();
            return;
          }

          var m = Math.floor((distance / 1000 / 60) % 60);
          var s = Math.floor((distance / 1000) % 60);
          timerEl.textContent = (m < 10 ? '0' : '') + m + ':' + (s < 10 ? '0' : '') + s;
          timerEl.setAttribute('datetime', 'PT' + m + 'M' + s + 'S');

          if (m < 5) timerEl.classList.add('urgent');
        }, 500);
      }

      //- Gate: show pre-exam screen, then begin on click
      var gate    = document.getElementById('exam-gate');
      var startBtn = document.getElementById('start-exam-btn');
      var shell   = document.getElementById('exam-shell');

      shell.style.display = 'none';
      gate.style.display  = 'flex';

      startBtn.addEventListener('click', function () {
        var doStart = function () {
          gate.classList.remove('visible');
          gate.style.display = 'none';
          shell.style.display = '';
          setTimeout(function() {
            if (window.codeEditors) {
              window.codeEditors.forEach(function(cm) { cm.refresh(); });
            }
          }, 50);
        };

        if (document.documentElement.requestFullscreen) {
          document.documentElement.requestFullscreen().then(doStart).catch(doStart);
        } else {
          doStart();
        }
      });

      //- Violation overlay dismiss
      var dismissBtn = document.getElementById('dismiss-violation');
      if (dismissBtn) {
        dismissBtn.addEventListener('click', function () {
          document.getElementById('violation-overlay').classList.remove('visible');
        });
      }
    })();

  //- Anti-cheat scripts (only in strict mode)
  if exam.strictMode
    script(src='/socket.io/socket.io.js')
    script(src='/js/anti-cheat.js')

block scripts
  link(rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.13/codemirror.min.css")
  link(rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.13/theme/dracula.min.css")
  script(src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.13/codemirror.min.js")
  script(src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.13/mode/javascript/javascript.min.js")
  script(src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.13/mode/python/python.min.js")
  script(src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.13/mode/clike/clike.min.js")
  script.
    document.addEventListener("DOMContentLoaded", function() {
      window.codeEditors = [];
      document.querySelectorAll('.code-editor').forEach(function(el) {
        var cm = CodeMirror.fromTextArea(el, {
          lineNumbers: true,
          mode: "javascript",
          theme: "dracula",
          viewportMargin: Infinity
        });
        window.codeEditors.push(cm);
      });
    });