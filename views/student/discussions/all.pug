extends ../../layouts/base

include ../../layouts/mixins

block content
  .page.space-y-8.pt-8
    +pgHeader({ eyebrow: 'Học sinh', icon: 'ph-bold ph-chats', h1: 'Tất cả thảo luận', subtitle: 'Mọi chủ đề thảo luận trên các lớp học của bạn, nhóm theo lớp học.' })
      .glass-panel.rounded-2xl.p-4.flex.items-center.gap-4(class='border-border/60')
        .w-10.h-10.rounded-xl.flex.items-center.justify-center.text-info(class='bg-info/10')
          i.ph-bold.ph-chats.text-lg
        div
          p.text-xs.font-bold.text-muted-foreground.uppercase.tracking-widest Thảo luận
          p.font-mono.text-2xl.font-bold.tracking-tighter= groups.reduce((n, g) => n + g.items.length, 0)

    if groups && groups.length
      .space-y-10.animate-in.slide-in-up(style='animation-delay:100ms;')
        each group in groups
          section.space-y-4
            .flex.items-center.gap-2
              i.ph-bold.ph-chalkboard.text-base.text-muted-foreground
              h2.text-lg.font-extrabold.tracking-tight= group.classroom.name
              if group.classroom.code
                span.text-xs.font-mono.text-muted-foreground · #{group.classroom.code}
            .space-y-3
              each topic in group.items.slice(0, 6)
                a.group.flex.items-center.justify-between.gap-4.card.p-4.transition-colors(href=`/student/classrooms/${group.classroom._id}/discussions/${topic._id}`, class='hover_border-primary/50')
                  .flex.items-start.gap-3.min-w-0
                    if topic.isPinned
                      i.ph-bold.ph-push-pin.text-warning.flex-shrink-0(class='mt-1')
                    .w-8.h-8.rounded-full.flex.items-center.justify-center.flex-shrink-0.text-xs.font-bold.text-primary(class='bg-primary/10')
                      if topic.author && topic.author.avatarUrl
                        img.w-full.h-full.rounded-full.object-cover(src=topic.author.avatarUrl, alt=topic.author.name)
                      else
                        = topic.author && topic.author.name ? topic.author.name.charAt(0).toUpperCase() : '?'
                    div.min-w-0
                      p.text-sm.font-bold.text-foreground.truncate= topic.title
                      p.text-xs.text-muted-foreground= topic.author && topic.author.name ? topic.author.name : 'Ai đó'
                  i.ph-bold.ph-arrow-right.text-muted-foreground.group-hover_text-primary.transition-colors.flex-shrink-0
    else
      +emptyState({ icon: 'ph-fill ph-chats', title: 'Chưa có thảo luận nào', desc: 'Khi có thảo luận trên lớp học bạn đã tham gia, chúng sẽ xuất hiện tại đây. Hãy tham gia một lớp học để bắt đầu.', ctaText: 'Tìm lớp học', ctaHref: '/catalog' })
