extends ../layouts/base

block content
  //- §2.1 Guest Journey: auth pages minimal — no distractions, clear CTA
  //- §6 Responsive: single column on mobile, split-screen on lg+
  .min-h-screen.flex

    //- ── LEFT BRAND PANEL (desktop only) ─────────────────────────────────
    .hidden.lg_flex.flex-col.justify-between.p-12.relative.overflow-hidden.flex-shrink-0.noise-overlay(class='w-[480px] bg-primary/5 border-r border-border/60', data-constellation)
      //- Ambient glow
      .hero-ambient(aria-hidden='true')

      //- Brand logo
      a.inline-flex.items-center.gap-3.relative.z-10(href='/', aria-label='EduSpace home')
        .w-10.h-10.rounded-xl.bg-primary.flex.items-center.justify-center.text-primary-foreground.shadow-sm
          i.ph-bold.ph-graduation-cap.text-xl(aria-hidden='true')
        span.font-bold.text-lg.tracking-tight= siteName || 'EduSpace'

      //- Center feature callouts
      .space-y-8.relative.z-10
        div
          h2.text-3xl.font-extrabold.tracking-tighter.mb-3 Chào mừng trở lại.
          p.text-muted-foreground.leading-relaxed Lớp học, bài thi và bài tập của bạn — tất cả trong một.

        .space-y-4
          -
            var helpItems = [
              {icon:'ph-chalkboard', text:'Truy cập lớp học của bạn ngay lập tức'},
              {icon:'ph-exam', text:'Làm bài thi trong chế độ tập trung không xao nhãng'},
              {icon:'ph-chart-line', text:'Theo dõi tiến độ và điểm số của bạn qua thời gian'}
            ];
          each item in helpItems
            .flex.items-center.gap-4
              .w-9.h-9.rounded-xl.flex.items-center.justify-center.flex-shrink-0(class='bg-primary/10 text-primary')
                i.ph-bold(class=item.icon + ' text-base', aria-hidden='true')
              p.text-sm.font-medium.text-foreground= item.text

      //- Footer
      .relative.z-10
        p.text-xs.text-muted-foreground &copy; #{new Date().getFullYear()} #{siteName || 'EduSpace'}. Được thiết kế cho lớp học thực tế.

    //- ── RIGHT FORM PANEL ─────────────────────────────────────────────────
    .flex-1.flex.items-center.justify-center.p-6.sm_p-10.relative.overflow-hidden.bg-background
      //- Subtle ambient on form side
      .absolute.inset-0.pointer-events-none(aria-hidden='true')
        div.absolute.top-1.of-4.right-0.w-96.h-96.rounded-full.bg-primary.opacity-5(style='filter:blur(100px);')

      .relative.z-10.w-full.max-w-md

        //- Header — visible on mobile where brand panel is hidden
        .flex.items-center.gap-3.mb-8.lg_hidden
          a.inline-flex.items-center.gap-2(href='/', aria-label='EduSpace home')
            .w-8.h-8.rounded-xl.bg-primary.flex.items-center.justify-center.text-primary-foreground
              i.ph-bold.ph-graduation-cap.text-sm(aria-hidden='true')
            span.font-bold.text-base.tracking-tight= siteName || 'EduSpace'

        h1.text-3xl.font-extrabold.tracking-tighter.mb-2 Đăng nhập vào tài khoản
        p.text-muted-foreground.text-sm.mb-8 Nhập thông tin đăng nhập của bạn dưới đây để tiếp tục.

        form.space-y-5(method='POST', action='/auth/login', novalidate)
          input(type='hidden', name='_csrf', value=csrfToken)

          //- Error alert (§12 Error States: specific, actionable)
          if errorMessage
            div.flex.items-start.gap-3.p-4.rounded-xl.border.animate-in.slide-in-down(role='alert', class='bg-destructive/5 border-destructive/20 text-destructive')
              i.ph-bold.ph-warning-circle.text-lg.flex-shrink-0(class='mt-0.5', aria-hidden='true')
              p.text-sm.font-medium.leading-snug= errorMessage

          //- Email
          .field
            label.field-label.text-xs.uppercase.tracking-widest.text-muted-foreground(for='email') Địa chỉ Email
            .input-icon
              .icon: i.ph-bold.ph-envelope-simple.text-lg.text-muted-foreground(aria-hidden='true')
              input#email(
                type='email', name='email', value=formData.email || '',
                required, autocomplete='email', placeholder='name@example.com',
                class='h-12 rounded-xl'
              )

          //- Password
          .field
            .flex.items-center.justify-between(style='margin-bottom:0.375rem;')
              label.field-label.text-xs.uppercase.tracking-widest.text-muted-foreground(for='password') Mật khẩu
              a.text-xs.font-bold.text-primary.transition-colors(class='hover_text-primary/80', href='/auth/forgot-password') Quên mật khẩu?
            .input-icon
              .icon: i.ph-bold.ph-lock.text-lg.text-muted-foreground(aria-hidden='true')
              input#password(
                type='password', name='password',
                required, autocomplete='current-password', placeholder='••••••••',
                class='h-12 rounded-xl pr-12'
              )
              button.absolute.inset-y-0.right-0.flex.items-center.pr-4.text-muted-foreground.hover_text-foreground.transition-colors(
                type='button', data-toggle-password='password', aria-label='Hiển thị mật khẩu'
              )
                i.ph-bold.ph-eye.text-lg(data-toggle-password-icon='password', aria-hidden='true')

          //- Submit
          button.btn-primary.btn-glow.w-full.h-12.text-base.rounded-xl.shadow-sm.active_scale-95.transition-transform.mt-2(type='submit')
            | Đăng nhập
            i.ph-bold.ph-arrow-right(aria-hidden='true')

        //- ── OAuth Divider ────────────────────────────────────────────────
        .flex.items-center.gap-3.mt-6
          .flex-1.h-px(class='bg-border/60')
          span.text-xs.text-muted-foreground.font-medium.uppercase.tracking-widest hoặc tiếp tục với
          .flex-1.h-px(class='bg-border/60')

        //- OAuth Buttons
        .flex.flex-col.gap-3.mt-4
          a.flex.items-center.justify-center.gap-3.w-full.h-12.rounded-xl.border.font-medium.text-sm.transition-all.active_scale-95(
            href='/auth/google',
            class='border-border/80 bg-background hover_bg-muted/60 text-foreground'
          )
            //- Google SVG icon
            svg(xmlns='http://www.w3.org/2000/svg', viewBox='0 0 24 24', width='20', height='20', aria-hidden='true')
              path(d='M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z', fill='#4285F4')
              path(d='M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z', fill='#34A853')
              path(d='M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z', fill='#FBBC05')
              path(d='M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z', fill='#EA4335')
            span Đăng nhập với Google

          a.flex.items-center.justify-center.gap-3.w-full.h-12.rounded-xl.border.font-medium.text-sm.transition-all.active_scale-95(
            href='/auth/facebook',
            class='border-border/80 bg-background hover_bg-muted/60 text-foreground'
          )
            //- Facebook SVG icon
            svg(xmlns='http://www.w3.org/2000/svg', viewBox='0 0 24 24', width='20', height='20', aria-hidden='true')
              path(d='M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z', fill='#1877F2')
            span Đăng nhập với Facebook

        .mt-6.pt-6.border-t.text-center(class='border-border/60')
          p.text-sm.text-muted-foreground
            | Chưa có tài khoản?&nbsp;
            a.font-bold.text-primary.hover_underline(href='/auth/register') Tạo tài khoản miễn phí