extends ../layouts/base

block content
  //- §2.1 Guest Journey, §12 Error States: forgot password consistent with auth layout
  .min-h-screen.flex

    //- ── LEFT BRAND PANEL (desktop only) ─────────────────────────────────
    .hidden.lg_flex.flex-col.justify-between.p-12.relative.overflow-hidden.flex-shrink-0.noise-overlay(class='w-[480px] bg-primary/5 border-r border-border/60', data-constellation)
      .hero-ambient(aria-hidden='true')

      a.inline-flex.items-center.gap-3.relative.z-10(href='/', aria-label='EduSpace home')
        .w-10.h-10.rounded-xl.bg-primary.flex.items-center.justify-center.text-primary-foreground.shadow-sm
          i.ph-bold.ph-graduation-cap.text-xl(aria-hidden='true')
        span.font-bold.text-lg.tracking-tight= siteName || 'EduSpace'

      .space-y-8.relative.z-10
        div
          h2.text-3xl.font-extrabold.tracking-tighter.mb-3 No worries.
          p.text-muted-foreground.leading-relaxed Enter your email and we'll send you a link to reset your password within minutes.

        .space-y-4
          -
            var helpItems = [
              {icon:'ph-envelope', text:'Check your inbox after submitting'},
              {icon:'ph-key', text:'Link expires after 24 hours for security'},
              {icon:'ph-lock-open', text:'You\'ll be able to set a new password'}
            ];
          each item in helpItems
            .flex.items-center.gap-4
              .w-9.h-9.rounded-xl.flex.items-center.justify-center.flex-shrink-0(class='bg-primary/10 text-primary')
                i.ph-bold(class=item.icon + ' text-base', aria-hidden='true')
              p.text-sm.font-medium.text-foreground= item.text

      .relative.z-10
        p.text-xs.text-muted-foreground &copy; #{new Date().getFullYear()} #{siteName || 'EduSpace'}.

    //- ── RIGHT FORM PANEL ─────────────────────────────────────────────────
    .flex-1.flex.items-center.justify-center.p-6.sm_p-10.bg-background.relative.overflow-hidden
      .absolute.inset-0.pointer-events-none(aria-hidden='true')
        div.absolute.top-1.of-4.right-0.w-96.h-96.rounded-full.bg-primary.opacity-5(style='filter:blur(100px);')

      .relative.z-10.w-full.max-w-md

        //- Mobile logo
        .flex.items-center.gap-3.mb-8.lg_hidden
          a.inline-flex.items-center.gap-2(href='/', aria-label='EduSpace home')
            .w-8.h-8.rounded-xl.bg-primary.flex.items-center.justify-center.text-primary-foreground
              i.ph-bold.ph-graduation-cap.text-sm(aria-hidden='true')
            span.font-bold.text-base.tracking-tight= siteName || 'EduSpace'

        //- Back link
        a.inline-flex.items-center.gap-2.text-sm.font-medium.text-muted-foreground.transition-colors.mb-8(class='hover_text-foreground', href='/auth/login')
          i.ph-bold.ph-arrow-left.text-sm(aria-hidden='true')
          | Back to sign in

        h1.text-3xl.font-extrabold.tracking-tighter.mb-2 Reset your password
        p.text-muted-foreground.text-sm.mb-8 We'll send you a link to get back into your account.

        //- Success state
        if message
          div.flex.items-start.gap-3.p-5.rounded-2xl.border.animate-in.slide-in-down(role='status', class='bg-success/5 border-success/20')
            i.ph-bold.ph-check-circle.text-success.text-xl.flex-shrink-0(class='mt-0.5', aria-hidden='true')
            div
              p.text-sm.font-bold.text-success.mb-1 Email sent!
              p.text-sm.text-muted-foreground.leading-snug= message

        //- Error state
        if errorMessage
          div.flex.items-start.gap-3.p-4.rounded-2xl.border.animate-in.slide-in-down(role='alert', class='bg-destructive/5 border-destructive/20 text-destructive mb-5')
            i.ph-bold.ph-warning-circle.text-lg.flex-shrink-0(class='mt-0.5', aria-hidden='true')
            p.text-sm.font-medium.leading-snug= errorMessage

        if !message
          form.space-y-5(method='POST', action='/auth/forgot-password', novalidate)
            input(type='hidden', name='_csrf', value=csrfToken)

            .field
              label.field-label.text-xs.uppercase.tracking-widest.text-muted-foreground(for='email') Email address
              .input-icon
                .icon: i.ph-bold.ph-envelope-simple.text-lg.text-muted-foreground(aria-hidden='true')
                input#email(type='email', name='email', required, autocomplete='email', placeholder='name@example.com', class='h-12 rounded-xl')

            button.btn-primary.btn-glow.w-full.h-12.text-base.rounded-xl.shadow-sm.active_scale-95.transition-transform.mt-2(type='submit')
              | Send reset link
              i.ph-bold.ph-paper-plane-tilt(aria-hidden='true')

        .mt-8.text-center
          p.text-sm.text-muted-foreground
            | Know your password?&nbsp;
            a.font-bold.text-primary.hover_underline(href='/auth/login') Sign in instead
