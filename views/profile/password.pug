extends ../layouts/base

block content
  .page.space-y-8
    nav.breadcrumb.mb-6
      a(href='/') Trang chủ
      span.breadcrumb-sep /
      a(href='/profile') Hồ sơ
      span.breadcrumb-sep /
      span.text-foreground.font-bold Mật khẩu

    .page-header
      p.eyebrow Bảo mật
      h1.page-header-title Đổi mật khẩu của bạn
      p.page-header-desc Hành động này chỉ áp dụng cho tài khoản cục bộ. Tài khoản chỉ OAuth giữ thông tin đăng nhập do nhà cung cấp quản lý.

    .max-w-lg
      form.card.p-8(method='POST', action='/profile/password')
        input(type='hidden', name='_csrf', value=csrfToken)
        if errorMessage
          .alert-danger.mb-6
            i.ph-bold.ph-warning-circle.text-lg.flex-shrink-0
            span= errorMessage

        .space-y-5
          .field
            label.field-label(for='currentPassword') Mật khẩu hiện tại
            .relative
              input#currentPassword(type='password', name='currentPassword', required, autocomplete='current-password', placeholder='Nhập mật khẩu hiện tại', class='w-full pr-12')
              button.absolute.inset-y-0.right-0.flex.items-center.pr-3.text-muted-foreground.hover_text-foreground.transition-colors(type='button', data-toggle-password='currentPassword', aria-label='Hiển thị mật khẩu')
                i.ph-bold.ph-eye.text-lg(data-toggle-password-icon='currentPassword')

          .field
            label.field-label(for='newPassword') Mật khẩu mới
            .relative
              input#newPassword(type='password', name='newPassword', required, autocomplete='new-password', placeholder='Nhập mật khẩu mới', class='w-full pr-12')
              button.absolute.inset-y-0.right-0.flex.items-center.pr-3.text-muted-foreground.hover_text-foreground.transition-colors(type='button', data-toggle-password='newPassword', aria-label='Hiển thị mật khẩu')
                i.ph-bold.ph-eye.text-lg(data-toggle-password-icon='newPassword')

          .field
            label.field-label(for='confirmPassword') Xác nhận mật khẩu
            .relative
              input#confirmPassword(type='password', name='confirmPassword', required, autocomplete='new-password', placeholder='Lặp lại mật khẩu mới', class='w-full pr-12')
              button.absolute.inset-y-0.right-0.flex.items-center.pr-3.text-muted-foreground.hover_text-foreground.transition-colors(type='button', data-toggle-password='confirmPassword', aria-label='Hiển thị mật khẩu')
                i.ph-bold.ph-eye.text-lg(data-toggle-password-icon='confirmPassword')

          .flex.gap-3.pt-2
            button.btn-primary(type='submit')
              i.ph-bold.ph-check
              | Cập nhật mật khẩu
            a.btn-outline(href='/profile') Hủy
