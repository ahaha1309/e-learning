extends ../layouts/base

block content
  .page-narrow.max-w-7xl.mx-auto.pt-8.pb-32
    .mb-12.animate-in-up
      nav.breadcrumb.mb-6
        a(href='/') Trang chủ
        span.breadcrumb-sep /
        span.text-foreground.font-bold Hồ sơ

      .page-header
        p.eyebrow Hồ sơ người dùng
        h1.page-header-title Cài đặt
        p.page-header-desc Quản lý chi tiết và tùy chọn tài khoản của bạn.

    .grid.grid-cols-1.gap-10.items-start(class='lg:grid-cols-[320px_minmax(0,1fr)]')
      aside.glass-panel.p-8.text-center.animate-in-up(style='animation-delay: 150ms; border-radius: 2rem;')
        .w-32.h-32.rounded-full.mx-auto.mb-6.flex.items-center.justify-center.font-extrabold.text-4xl.border-4.overflow-hidden(class='bg-primary/10 text-primary border-primary/20')
          if user.avatarUrl
            img.w-full.h-full.object-cover(src=user.avatarUrl, alt=user.name)
          else
            = user.name ? user.name.charAt(0).toUpperCase() : '?'
        h2.text-2xl.font-bold.text-foreground= user.name
        p.text-sm.text-muted-foreground.mt-2= user.email
        .flex.items-center.justify-center.gap-3.mt-4
          span.badge-primary.capitalize= user.role
          span.badge-success.capitalize= user.status
        div.mt-8.pt-8.border-t.flex.flex-col.gap-3(class='border-border/60')
          a.btn-primary.w-full.h-12.rounded-full.font-bold(href='/profile/edit')
            i.ph-bold.ph-pencil-simple.text-lg
            | Chỉnh sửa hồ sơ
          a.btn-outline.w-full.h-12.rounded-full.font-bold.text-muted-foreground(href='/profile/password')
            i.ph-bold.ph-lock-key.text-lg
            | Đổi mật khẩu

      .space-y-8.animate-in-up(style='animation-delay: 250ms;')
        .glass-panel.p-8.md_p-10(style='border-radius: 2.5rem;')
          h2.text-2xl.font-extrabold.tracking-tight.mb-8 Chi tiết tài khoản
          dl.grid.gap-y-6.gap-x-8(style='grid-template-columns: 200px minmax(0, 1fr);')
            dt.text-sm.font-bold.uppercase.tracking-widest.text-muted-foreground Tên
            dd.text-lg.font-medium.text-foreground.border-b.pb-6(class='border-border/60')= user.name

            dt.text-sm.font-bold.uppercase.tracking-widest.text-muted-foreground Email
            dd.text-lg.font-medium.text-foreground.border-b.pb-6(class='border-border/60')= user.email

            dt.text-sm.font-bold.uppercase.tracking-widest.text-muted-foreground Số điện thoại
            dd.text-lg.font-medium.text-foreground.border-b.pb-6(class='border-border/60')= user.phone || 'Chưa thiết lập'

            dt.text-sm.font-bold.uppercase.tracking-widest.text-muted-foreground Hình đại diện
            dd.text-sm.font-medium.text-muted-foreground.break-all= user.avatarUrl || 'Chưa thiết lập'
